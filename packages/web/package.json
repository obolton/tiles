{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "description": "Web frontend",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=\"../../.env\" --clear-screen=false scripts/dev.ts",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --outDir dist/_worker.js --ssr",
    "build": "npm run build:client && npm run build:server",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint:ts": "eslint src",
    "lint:css": "stylelint \"src/**/*.{css}\"",
    "lint": "npm run lint:ts && npm run lint:css",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "tsc": "tsc --build",
    "generate-worker-types": "wrangler types src/types/worker.d.ts --include-runtime=false"
  },
  "dependencies": {
    "@trpc/client": "^11.1.2",
    "entities": "^6.0.0",
    "maplibre-gl": "^5.6.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.1",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.40.0"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.0.0",
    "postcss-html": "^1.8.0",
    "storybook": "^9.0.6",
    "stylelint": "^16.21.1",
    "stylelint-config-standard": "^38.0.0",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^6.3.5",
    "wrangler": "^4.14.3"
  }
}
