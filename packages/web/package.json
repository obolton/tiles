{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "description": "Web frontend",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=\"../../.env\" --clear-screen=false scripts/dev.ts",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --outDir dist/_worker.js --ssr",
    "build": "npm run build:client && npm run build:server",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint:ts": "oxlint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint": "npm run lint:ts && npm run lint:css",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "tsc": "tsc --build",
    "generate-worker-types": "wrangler types src/types/worker.d.ts --include-runtime=false"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "@trpc/client": "^11.5.0",
    "entities": "^6.0.0",
    "maplibre-gl": "^5.6.2",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.3",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.41.1"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "autoprefixer": "^10.4.22",
    "jsdom": "^27.0.0",
    "postcss-html": "^1.8.0",
    "storybook": "^9.1.10",
    "stylelint": "^16.26.0",
    "stylelint-config-standard": "^39.0.1",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.2.2",
    "wrangler": "^4.44.0"
  }
}
