{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "description": "Web frontend",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:next": "tsx watch --env-file=\"../../.env\" --clear-screen=false scripts/dev.ts",
    "start": "astro dev",
    "check": "astro check",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr",
    "build": "npm run build:client && npm run build:server",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint:ts": "eslint src",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint": "npm run lint:ts && npm run lint:css",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "tsc": "tsc --build",
    "generate-worker-types": "wrangler types src/types/worker.d.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.4.0",
    "@astrojs/react": "^4.2.3",
    "@trpc/client": "^11.1.2",
    "astro": "^5.6.1",
    "entities": "^6.0.0",
    "maplibre-gl": "^5.2.0",
    "prosemirror-commands": "^1.7.0",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.25.0",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.38.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.8",
    "@storybook/react": "^8.6.8",
    "@storybook/react-vite": "^8.6.8",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.0.0",
    "postcss-html": "^1.8.0",
    "storybook": "^8.6.8",
    "stylelint": "^16.16.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^37.0.0",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^6.3.0",
    "wrangler": "^4.14.3"
  }
}
