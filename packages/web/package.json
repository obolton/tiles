{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "description": "Web frontend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=\"../../../.env\" --clear-screen=false scripts/dev.ts",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --outDir dist/_worker.js --ssr",
    "build": "pnpm build:client && pnpm build:server",
    "generate": "cmk",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint:ts": "oxlint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint": "pnpm run \"/^lint:.*/\"",
    "storybook": "storybook dev -p 6001 --no-open --no-version-updates",
    "storybook:build": "storybook build",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@hocuspocus/provider": "^4.3.0",
    "@lezer/highlight": "^1.2.1",
    "@observablehq/plot": "^0.6.17",
    "@trpc/client": "^11.18.0",
    "api": "workspace:*",
    "cookie": "^2.0.1",
    "culori": "^4.0.2",
    "doc": "workspace:*",
    "entities": "^8.0.0",
    "jittered-fractional-indexing": "^1.0.1",
    "jose": "^6.2.2",
    "maplibre-gl": "^5.24.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.42.1",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@css-modules-kit/codegen": "^1.4.0",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/html-vite": "^10.5.0",
    "@types/culori": "^4.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "autoprefixer": "^10.5.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss-html": "^1.8.1",
    "storybook": "^10.5.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "svgo": "^4.0.2",
    "tsx": "^4.22.4",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
