{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "outDir": "dist",
    "jsx": "react-jsx",
    "jsxImportSource": "@/jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*", "./scripts/**/*"],
  "references": [{ "path": "../api" }],

  "cmkOptions": {
    "enabled": true,
    "dtsOutDir": "."
  }
}
