{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "outDir": "dist",
    "jsx": "react-jsx",
    "jsxImportSource": "jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "."
  },
  "include": ["./src/**/*", "./scripts/**/*"],
  "references": [
    { "path": "../api" },
    { "path": "../doc" },
    { "path": "../env" },
    { "path": "../fonts" },
    { "path": "../jsx" }
  ],

  "cmkOptions": {
    "enabled": true,
    "dtsOutDir": "."
  }
}
