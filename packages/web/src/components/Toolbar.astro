---
interface Props {
  id?: string;
  label: string;
}

const { id, label } = Astro.props;
---

<div id={id} class="toolbar" role="toolbar" aria-label={label}><slot /></div>
<style>
  .toolbar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 24px;
    padding: 8px;
    background: linear-gradient(
      0deg,
      rgba(224, 224, 230, 0.9),
      rgba(240, 240, 240, 0.9)
    );
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.2),
      0 4px 4px -2px rgba(0, 0, 0, 0.2);
    font-size: 16px;
    line-height: 16px;
  }
</style>
