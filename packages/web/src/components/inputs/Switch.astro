---
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<label>
  {label}
  <input id={id} type="checkbox" role="switch" />
  <div class="switch"></div>
</label>
<style>
  label {
    display: flex;
    align-items: center;
    font-size: 1rem;
    line-height: 1rlh;
    text-shadow: 0 1px 1px rgb(255 255 255 / 70%);
    padding: 0 0 0 8px;
    user-select: none;
  }

  input {
    appearance: none;
    width: 0;
    height: 0;
  }

  .switch {
    cursor: pointer;
    box-sizing: border-box;
    position: relative;
    width: 3.2rem;
    height: 1.8rem;
    margin-left: 0.75rem;
    border-radius: 0.9rem;
    border: 2px solid rgb(0 0 0 / 50%);
    background-color: #ccc;
    box-shadow: inset 0 0 4px 1px rgb(0 0 0 / 20%);
    transition: background-color 0.2s ease;
  }

  .switch::after {
    content: "";
    position: absolute;
    width: calc(1.8rem - 10px);
    height: calc(1.8rem - 10px);
    left: 3px;
    top: 3px;
    border-radius: 10px;
    background-color: #fff;
    box-shadow: 0 0 3px 1px rgb(0 0 0 / 30%);
    transition: transform 0.2s ease;
  }

  input:checked + .switch {
    background-color: #84e2cf;
  }

  input:checked + .switch::after {
    transform: translateX(1.4rem);
  }

  input:focus-visible + .switch {
    outline: 2px solid #0070f3;
    outline-offset: 2px;
  }
</style>
