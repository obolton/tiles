---
const TILE_TYPES = [
  { name: "Image", value: "image" },
  { name: "Text", value: "text" },
  { name: "Map", value: "map" },
];
---

<div id="tileTypeSelector" class="editable">
  <menu role="menu" tabindex="0">
    {
      TILE_TYPES.map((type) => (
        <li role="menuitem" data-value={type.value}>
          {type.name}
        </li>
      ))
    }
  </menu>
</div>
<style>
  #tileTypeSelector {
    position: relative;
    visibility: hidden;
    border-radius: 8px;
    max-height: 200px;
    overflow: hidden;
    container: selector / size;
    --item-height: 70px;
  }

  body[data-editing] #tileTypeSelector {
    visibility: visible;
  }

  menu {
    list-style: none;
    padding: 0;
    width: 100%;
    height: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    overflow: scroll;
    overscroll-behavior: contain;
    scroll-snap-type: y mandatory;
    outline: none;
  }

  li {
    cursor: pointer;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: 600;
    text-align: center;
    height: var(--item-height);
    scroll-snap-align: center;
    opacity: 0.5;
    font-size: 18px;
    border-radius: 16px;
    background-color: transparent;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      font-size 0.2s ease,
      background-color 0.2s ease;
  }

  @container selector (height > 100px) {
    li:first-of-type {
      margin-top: calc((100cqh - var(--item-height)) / 2);
    }

    li:last-of-type {
      margin-bottom: calc((100cqh - var(--item-height)) / 2);
    }
  }

  li.selected {
    opacity: 1;
    font-size: 24px;
    background: #f0f0f0;
  }
</style>
<script>
  import { setSearchParam } from "../utils/navigation";
  const root = document.getElementById("tileTypeSelector");

  // Highlight the selected item
  const observer = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("selected");
        } else {
          entry.target.classList.remove("selected");
        }
      }),
    {
      root,
      rootMargin: "-50% 0px -50% 0px",
      threshold: 0,
    }
  );
  document.querySelectorAll("#tileTypeSelector menu li").forEach((element) => {
    observer.observe(element);
    element.addEventListener("pointerdown", (event) =>
      setSearchParam(
        "modal",
        (event.target as HTMLElement).getAttribute("data-value")
      )
    );
  });
</script>
