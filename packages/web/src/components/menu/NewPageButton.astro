---
import newIcon from "../../icons/new.svg";
---

<button
  id="new-page-button"
  class="floating"
  type="button"
  aria-label="Create a new page"
>
  <span>New page</span>
  <img src={newIcon.src} alt="Plus icon" />
</button>
<style>
  #new-page-button {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1;
  }

  body:not([data-signed-in]) #new-page-button {
    display: none;
  }
</style>
<script>
  import client from "../../api/client";
  document.getElementById("new-page-button")!.addEventListener("click", () => {
    client.pages.create
      .mutate({ title: "New page" })
      .then(({ id }) => {
        window.open(`/pages/${id}?edit=true`, "_blank");
      })
      .catch((error) => console.error(error));
  });
</script>
