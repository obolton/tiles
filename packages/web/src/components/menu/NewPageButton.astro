---
import newIcon from "../../icons/new.svg";
---

<button
  id="newPageButton"
  class="floating"
  type="button"
  aria-label="Create a new page"
>
  <span>New page</span>
  <img src={newIcon.src} alt="Plus icon" />
</button>
<style>
  #newPageButton {
    position: fixed;
    bottom: 24px;
    right: 24px;
  }
</style>
<script>
  import client from "../../api/client";
  document.getElementById("newPage")!.addEventListener("click", () => {
    client.pages.create
      .mutate({ title: "New page" })
      .then(({ id }) => {
        window.open(`/pages/${id}?edit=true`, "_blank");
      })
      .catch((error) => console.error(error));
  });
</script>
