---
import newIcon from "../../icons/new.svg";
---

<button
  id="new-page-button"
  class="floating"
  type="button"
  aria-label="Create a new page"
  data-pending-text=""
>
  <span>New page</span>
  <img src={newIcon.src} alt="Plus icon" />
</button>
<style>
  #new-page-button {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1;
  }

  body:not([data-signed-in]) #new-page-button {
    display: none;
  }
</style>
<script>
  import client from "@/api/client";
  import { handleError } from "@/utils/errors";
  document
    .getElementById("new-page-button")!
    .addEventListener("click", (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      button.classList.add("pending");
      client.pages.create
        .mutate({ title: "New page" })
        .then(({ id }) => {
          button.classList.remove("pending");
          window.open(`/pages/${id}?edit=true`, "_blank");
        })
        .catch(handleError);
    });
</script>
