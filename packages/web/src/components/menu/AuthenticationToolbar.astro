---
import Toolbar from "./Toolbar.astro";
import Flippable from "../Flippable.astro";
---

<Flippable id="authentication" axis="x" width="12rem">
  <Toolbar id="signIn" label="Account toolbar" slot="front">
    <a href="/sign-in">Sign in</a>
  </Toolbar>
  <Toolbar id="user" label="Account toolbar" slot="back" />
</Flippable>
<style is:global>
  .profileImage {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.3);
  }
</style>
<script>
  import {
    isSignedIn,
    getUserInfo,
    getCachedUserInfo,
  } from "../../utils/sessions";

  function showUserInfo({
    name,
    imageUrl,
  }: {
    name: string;
    imageUrl: string | null;
  }) {
    const user = document.getElementById("user")!;
    if (imageUrl) {
      user.innerHTML = `<img class="profileImage" src="${imageUrl}" alt="Your profile picture" /><span>${name}</span>`;
    } else {
      user.innerHTML = `<span>${name}</span>`;
    }
  }

  if (isSignedIn()) {
    const authState = document.getElementById("authentication")!;
    const signIn = document.getElementById("signIn")!;
    const userInfo = getCachedUserInfo();

    if (userInfo) {
      showUserInfo(userInfo);
      authState.dataset.animate = "false";
      authState.dataset.flipped = "true";
    } else {
      signIn.innerHTML = "Signing in...";

      Promise.all([
        getUserInfo().then((user) => showUserInfo(user)),
        new Promise((resolve) => setTimeout(resolve, 1500)),
      ])
        .then(() => {
          authState.dataset.animate = "true";
          authState.dataset.flipped = "true";
        })
        .catch((error) => {
          console.error(error);
        });
    }
  }
</script>
