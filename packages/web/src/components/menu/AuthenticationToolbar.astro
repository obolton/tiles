---
import Toolbar from "./Toolbar.astro";
import Flippable from "../Flippable.astro";
import profileIcon from "@/icons/profile.svg";
import settingsIcon from "@/icons/settings.svg";
import signOutIcon from "@/icons/sign-out.svg";
---

<div id="authentication-toolbar">
  <Flippable id="authentication" axis="x" width="12rem" height="48px">
    <Toolbar id="sign-in" label="Account toolbar" slot="front">
      <a href="/sign-in">Sign in</a>
    </Toolbar>

    <Toolbar id="user" label="Account toolbar" slot="back">
      <data-binding href="user.profile">
        <a href="/profiles">
          <data-binding src="user.imageUrl" name="user.name">
            <profile-image></profile-image>
          </data-binding>
          <data-binding text="user.name"><span></span></data-binding>
        </a>
      </data-binding>
    </Toolbar>
  </Flippable>

  <nav class="nav-menu">
    <menu class="vertical nav-items">
      <li>
        <data-binding href="user.profile">
          <a href="/profiles">
            <img class="icon" src={profileIcon.src} alt="" />
            Profile
          </a>
        </data-binding>
      </li>
      <li>
        <a href="/settings">
          <img class="icon" src={settingsIcon.src} alt="" />
          Settings
        </a>
      </li>
      <li>
        <button id="sign-out" type="button">
          <img class="icon" src={signOutIcon.src} alt="" />
          Sign out
        </button>
      </li>
    </menu>
  </nav>
</div>
<style is:global>
  #authentication {
    z-index: 1;
  }

  #user a {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
  }

  #user a span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #sign-in a {
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1rem;
    width: 100%;
    height: 100%;
  }

  #authentication-toolbar #user {
    transition: background-color 0.5s ease;
  }

  #authentication-toolbar:hover #user {
    background: rgb(240 240 240 / 100%);
  }
</style>
<style>
  #authentication-toolbar {
    position: relative;
    overflow: visible;
    height: 48px;
  }

  .nav-menu {
    z-index: 0;
    position: absolute;
    top: 24px;
    left: 0;
    width: 100%;
    clip-path: inset(0 -10px -10px -10px);
    pointer-events: none;
  }

  .nav-items {
    padding: 32px 0 0;
    border-radius: 0 0 24px 24px;
    background: rgba(240 240 240 / 95%);
    backdrop-filter: blur(2px);
    box-shadow:
      0 0 0 1px rgba(0 0 0 / 20%),
      0 4px 4px -3px rgb(0 0 0 / 20%);
    overflow: hidden;
    opacity: 0;
    filter: blur(3px);
    transform: translateY(-100%);
    transition:
      opacity 0.5s ease,
      filter 0.5s ease,
      transform 0.5s ease;
  }

  body.color .nav-items {
    background: oklch(from var(--page-color) 94% 15% h / 95%);
  }

  body[data-signed-in] #authentication-toolbar:hover .nav-items,
  body[data-signed-in] #authentication-toolbar:focus-within .nav-items {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav-items li:last-child a,
  .nav-items li:last-child button {
    padding: 12px 19px 13px;
  }

  .icon {
    opacity: 0.8;
    width: 18px;
    height: 18px;
    filter: drop-shadow(0 1px 0 rgb(255 255 255 / 15%));
  }
</style>
<script>
  import {
    isSignedIn,
    getUserInfo,
    getCachedUserInfo,
    signOut,
  } from "@/utils/sessions";
  import { handleError } from "@/utils/errors";
  const signIn = document.getElementById("sign-in")!;
  const authState = document.getElementById("authentication")!;
  const signOutButton = document.getElementById("sign-out")!;

  signOutButton.addEventListener("click", async () => {
    signIn.innerHTML = '<a href="/sign-in">Sign in</a>';
    authState.dataset.animate = "true";
    delete authState.dataset.flipped;
    await signOut();
    delete document.body.dataset.signedIn;
    window.location.href = "/";
  });

  if (isSignedIn()) {
    const userInfo = getCachedUserInfo();

    if (userInfo) {
      authState.dataset.animate = "false";
      authState.dataset.flipped = "true";
    } else {
      signIn.innerHTML = "Signing in...";

      Promise.all([
        getUserInfo(),
        new Promise((resolve) => setTimeout(resolve, 1000)),
      ])
        .then(() => {
          authState.dataset.animate = "true";
          authState.dataset.flipped = "true";
        })
        .catch((error) => {
          signIn.innerHTML = '<a href="/sign-in">Sign in</a>';
          handleError(error);
        });
    }
  }
</script>
