---
import AuthenticationToolbar from "./AuthenticationToolbar.astro";
import EditingToolbar from "./EditingToolbar.astro";
import NewPageButton from "./NewPageButton.astro";
import CreateTileToolbar from "./CreateTileToolbar";
import FormattingToolbar from "./FormattingToolbar";

interface Props {
  pageId: string;
  allowDelete?: boolean;
}
const { pageId, allowDelete } = Astro.props;
---

<div id="menubar" role="menubar" aria-label="Menu bar">
  <EditingToolbar allowDelete={allowDelete} />
  <AuthenticationToolbar />
  <CreateTileToolbar pageId={pageId} client:edit />
</div>
<FormattingToolbar pageId={pageId} client:edit />
<NewPageButton />
<style>
  #menubar {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 1;
    display: flex;
    gap: 1rem;
  }
</style>
