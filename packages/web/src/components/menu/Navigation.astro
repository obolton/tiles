---
import homeIcon from "@/icons/home.svg";
import newIcon from "@/icons/new.svg";
import libraryIcon from "@/icons/library.svg";
import settingsIcon from "@/icons/settings.svg";
import signOutIcon from "@/icons/sign-out.svg";
import menuIcon from "@/icons/menu.svg";
---

<nav id="navigation" class="toolbar">
  <menu data-tooltip-position="right">
    <li>
      <data-binding href="user.profile">
        <a href="/profiles" class="floating" data-tooltip="Your profile">
          <data-binding src="user.imageUrl" alt="user.name">
            <img class="profile-image" />
          </data-binding>
        </a>
      </data-binding>
    </li>
    <li>
      <a href="/" class="floating" aria-label="Home" data-tooltip="Home">
        <img class="icon" src={homeIcon.src} alt="Home" />
      </a>
    </li>
    <li>
      <button
        id="new-page-button"
        class="floating"
        type="button"
        data-tooltip="Create a new page"
        data-pending-text=""
      >
        <img src={newIcon.src} alt="Plus icon" />
      </button>
    </li>
    <li>
      <a
        href="/library"
        class="floating"
        aria-label="Library"
        data-tooltip="Library"
      >
        <img class="icon" src={libraryIcon.src} alt="Library" />
      </a>
    </li>
    <li>
      <button
        id="more-button"
        class="floating"
        type="button"
        role="menuitem"
        popovertarget="navigation-overflow"
        data-tooltip="More options"
        aria-haspopup="menu"
        aria-expanded="false"
      >
        <img
          class="icon"
          src={settingsIcon.src}
          alt="Settings"
          aria-hidden="true"
        />
      </button>
      <popover-menu id="navigation-overflow" anchor="more-button">
        <menu>
          <li>
            <a href="/settings">
              <img
                class="icon"
                src={settingsIcon.src}
                alt="Settings"
                aria-hidden="true"
              />Account settings
            </a>
          </li>
          <li>
            <button id="sign-out" type="button"
              ><img
                class="icon"
                src={signOutIcon.src}
                alt="Sign out"
                aria-hidden="true"
              />Sign out
            </button>
          </li>
        </menu>
      </popover-menu>
    </li>
    <li>
      <button
        id="toc-button"
        class="floating"
        type="button"
        role="menuitem"
        popovertarget="toc"
        data-tooltip="Table of contents"
        aria-haspopup="menu"
        aria-expanded="false"
      >
        <img
          class="icon"
          src={menuIcon.src}
          alt="Table of contents"
          aria-hidden="true"
        />
      </button>
      <table-of-contents id="toc" anchor="toc-button" role="navigation"
      ></table-of-contents>
    </li>
  </menu>
</nav>
<style>
  body:not([data-signed-in]) #navigation {
    display: none;
  }
</style>
<script>
  import client from "@/api/client";
  import { handleError } from "@/utils/errors";
  import { signOut } from "@/utils/sessions";

  const newPageButton = document.getElementById("new-page-button");
  const signOutButton = document.getElementById("sign-out");

  newPageButton?.addEventListener("click", () => {
    newPageButton.classList.add("pending");
    client.pages.create
      .mutate({ title: "New page" })
      .then(({ id }) => {
        newPageButton.classList.remove("pending");
        window.open(`/pages/${id}?edit=true`, "_blank");
      })
      .catch(handleError);
  });

  signOutButton?.addEventListener("click", async () => {
    await signOut();
    delete document.body.dataset.signedIn;
    window.location.href = "/";
  });
</script>
