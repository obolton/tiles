---
import NewIcon from "@/icons/new.svg?jsx";
import LibraryIcon from "@/icons/library.svg?jsx";
import SettingsIcon from "@/icons/settings.svg?jsx";
import SignOutIcon from "@/icons/sign-out.svg?jsx";
import MenuIcon from "@/icons/menu.svg?jsx";

interface Props {
  showTableOfContents?: boolean;
}

const { showTableOfContents } = Astro.props;
---

<nav
  id="navigation"
  aria-label="Main navigation links"
  data-tooltip-position="right"
>
  <ul>
    <li>
      <data-binding href="user.profile">
        <a href="/profiles" class="floating" data-tooltip="Your profile">
          <data-binding src="user.imageUrl" alt="user.name">
            <img class="profile-image" />
          </data-binding>
        </a>
      </data-binding>
    </li>
    <li>
      <a
        href="/library"
        class="floating"
        aria-label="Library"
        data-tooltip="Library"
      >
        <LibraryIcon />
      </a>
    </li>
    <li>
      <button
        id="new-page-button"
        class="floating"
        type="button"
        data-tooltip="Create a new page"
        data-pending-text=""
      >
        <NewIcon />
      </button>
    </li>
    <li>
      <button
        id="more-button"
        class="floating"
        type="button"
        role="menuitem"
        popovertarget="navigation-overflow"
        data-tooltip="More options"
        aria-haspopup="menu"
        aria-expanded="false"
      >
        <SettingsIcon />
      </button>
      <popover-menu id="navigation-overflow" anchor="more-button">
        <menu>
          <li>
            <a href="/settings">
              <SettingsIcon />Account settings
            </a>
          </li>
          <li>
            <button id="sign-out" type="button"
              ><SignOutIcon />Sign out
            </button>
          </li>
        </menu>
      </popover-menu>
    </li>
    {
      showTableOfContents ? (
        <li>
          <button
            id="toc-button"
            class="floating"
            type="button"
            role="menuitem"
            popovertarget="toc"
            data-tooltip="Table of contents"
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <MenuIcon />
          </button>
          <table-of-contents id="toc" anchor="toc-button" role="navigation" />
        </li>
      ) : null
    }
  </ul>
</nav>
<style>
  body:not([data-signed-in]) #navigation {
    display: none;
  }
</style>
<script>
  import client from "@/api/client";
  import { handleError } from "@/utils/errors";
  import { signOut } from "@/utils/sessions";

  const newPageButton = document.getElementById("new-page-button");
  const signOutButton = document.getElementById("sign-out");

  newPageButton?.addEventListener("click", () => {
    newPageButton.classList.add("pending");
    client.pages.create
      .mutate({ title: "New page" })
      .then(({ id }) => {
        newPageButton.classList.remove("pending");
        window.open(`/pages/${id}?edit=true`, "_blank");
      })
      .catch(handleError);
  });

  signOutButton?.addEventListener("click", async () => {
    await signOut();
    delete document.body.dataset.signedIn;
    window.location.href = "/";
  });
</script>
