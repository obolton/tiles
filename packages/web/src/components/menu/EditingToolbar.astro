---
import EditingTools from "./EditingTools";

interface Props {
  pageId: string;
  allowDelete?: boolean;
}

const { pageId, allowDelete = true } = Astro.props;
---

<div
  id="editing-toolbar"
  class="toolbar secondary"
  role="toolbar"
  aria-label="Editing toolbar"
>
  <label id="edit-label">
    Edit
    <input id="editSwitch" type="checkbox" role="switch" />
  </label>

  <EditingTools pageId={pageId} allowDelete={allowDelete} client:edit />
</div>
<style is:global>
  body:not([data-signed-in]) #editing-toolbar {
    display: none;
  }
</style>
<style>
  #edit-label {
    flex-direction: column;
    font-size: 1rem;
    gap: 2px;
    font-variant-caps: all-small-caps;
    font-weight: 600;
  }
</style>
<script is:inline>
  const url = new URL(window.location);
  const editSearchParam = url.searchParams.get("edit");

  const editPath = JSON.parse(sessionStorage.getItem("edit") ?? "null");
  const isEditing = editPath === url.pathname || editSearchParam;

  if (editSearchParam) {
    url.searchParams.delete("edit");
    sessionStorage.setItem("edit", JSON.stringify(url.pathname));
    history.replaceState(null, "", url);
  }

  if (isEditing) {
    document.body.dataset.editing = "true";
    document.getElementById("editSwitch").checked = true;
  }
</script>
<script>
  import { setEditMode } from "@/utils/edit";
  const editSwitch = document.getElementById("editSwitch") as HTMLInputElement;
  editSwitch.addEventListener("change", () => setEditMode(editSwitch.checked), {
    passive: true,
  });
</script>
