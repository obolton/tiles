---
import Toolbar from "./Toolbar.astro";
import Switch from "../inputs/Switch.astro";
import moreIcon from "@/icons/more.svg";
import trashIcon from "@/icons/trash.svg";

interface Props {
  allowDelete?: boolean;
}

const { allowDelete = true } = Astro.props;
---

<Toolbar id="editing-toolbar" label="Editing toolbar">
  <Switch id="editSwitch" label="Edit" />
  <button
    type="button"
    popovertarget="page-options"
    aria-label="More options"
    aria-haspopup="menu"
  >
    <img
      class="icon"
      src={moreIcon.src}
      alt="More options"
      aria-hidden="true"
    />
  </button>
  <popover-menu id="page-options" anchor="editing-toolbar" align="right">
    <menu class="vertical">
      <li>
        <button
          id="delete-page"
          class="destructive"
          type="button"
          disabled={allowDelete ? undefined : true}
        >
          <img
            class="icon"
            src={trashIcon.src}
            alt="Delete"
            aria-hidden="true"
          />
          Delete page
        </button>
      </li>
    </menu>
  </popover-menu>
</Toolbar>
<style is:global>
  body:not([data-signed-in]) #editing-toolbar {
    display: none;
  }
</style>
<style>
  .icon {
    opacity: 0.8;
    width: 18px;
    height: 18px;
    filter: drop-shadow(0 1px 0 rgb(255 255 255 / 15%));
  }
</style>
<script is:inline>
  const url = new URL(window.location);
  const editSearchParam = url.searchParams.get("edit");
  const isEditing = sessionStorage.getItem("edit") || editSearchParam;

  if (editSearchParam) {
    url.searchParams.delete("edit");
    sessionStorage.setItem("edit", "true");
    history.replaceState(null, "", url);
  }

  if (isEditing) {
    document.body.dataset.editing = "true";
    document.getElementById("editSwitch").checked = true;
  }
</script>
<script>
  import { setEditMode } from "@/utils/edit";
  import client from "@/api/client";
  const editSwitch = document.getElementById("editSwitch") as HTMLInputElement;
  editSwitch.addEventListener("change", () => setEditMode(editSwitch.checked), {
    passive: true,
  });
  document
    .getElementById("delete-page")!
    .addEventListener("click", async () => {
      const pageId = document.body.dataset.pageId ?? "";
      await client.pages.delete.mutate({ id: pageId });
      window.location.href = "/";
    });
</script>
