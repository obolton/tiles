---
import EditingTools from "./EditingTools";
import shareIcon from "@/icons/share.svg";
import bookmarkIcon from "@/icons/bookmark.svg";

interface Props {
  isPublished: boolean;
  allowDelete?: boolean;
  allowPublish?: boolean;
}

const { isPublished, allowDelete = true, allowPublish = true } = Astro.props;
---

<div
  id="editing-toolbar"
  class="toolbar secondary"
  role="toolbar"
  aria-label="Editing toolbar"
>
  <label id="edit-label">
    Edit
    <input id="edit-switch" type="checkbox" role="switch" />
  </label>

  <button id="share" class="floating tooltip-left" aria-label="Share">
    <img class="icon" src={shareIcon.src} alt="Share" />
  </button>

  <button
    id="bookmark"
    class="floating tooltip-left"
    aria-label="Bookmark"
    aria-pressed="false"
  >
    <img class="icon" src={bookmarkIcon.src} alt="Bookmark" />
  </button>

  <EditingTools
    isPublished={isPublished}
    allowPublish={allowPublish}
    allowDelete={allowDelete}
    client:edit
  />
</div>
<style is:global>
  body:not([data-signed-in]) {
    #bookmark,
    #editing-toolbar {
      display: none;
    }
  }
</style>
<style>
  #edit-label {
    flex-direction: column;
    font-size: 1rem;
    gap: 4px;
    font-variant-caps: all-small-caps;
    font-weight: 600;
  }
</style>
<script is:inline>
  const url = new URL(window.location);
  const editSearchParam = url.searchParams.get("edit");

  const editPath = JSON.parse(sessionStorage.getItem("edit") ?? "null");
  const isEditing = editPath === url.pathname || editSearchParam;

  if (editSearchParam) {
    url.searchParams.delete("edit");
    sessionStorage.setItem("edit", JSON.stringify(url.pathname));
    history.replaceState(null, "", url);
  }

  if (isEditing) {
    document.body.dataset.editing = "true";
    document.getElementById("edit-switch").checked = true;
  }
</script>
<script>
  import { setEditMode } from "@/utils/edit";
  import { sharePage } from "@/utils/sharing";
  const editSwitch = document.getElementById("edit-switch") as HTMLInputElement;
  editSwitch.addEventListener("change", () => setEditMode(editSwitch.checked), {
    passive: true,
  });
  document.getElementById("share")?.addEventListener("click", sharePage);
</script>
<script src="@/init.ts"></script>
