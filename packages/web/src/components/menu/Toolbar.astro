---
interface Props {
  id?: string;
  label: string;
}

const { id, label } = Astro.props;
---

<div id={id} class="toolbar" role="toolbar" aria-label={label}><slot /></div>
<style>
  .toolbar {
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    border-radius: 24px;
    padding: 12px;
    background-color: rgba(240, 240, 240, 0.9);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.3),
      0 4px 4px -2px rgba(0, 0, 0, 0.2),
      inset 0 0px 1px 1px rgba(255, 255, 255, 0.5);
    font-size: 16px;
    line-height: 16px;
    z-index: 1;
  }
</style>
