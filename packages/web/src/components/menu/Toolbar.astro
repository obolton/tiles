---
interface Props {
  id?: string;
  label: string;
}

const { id, label } = Astro.props;
---

<div id={id} class="toolbar" role="toolbar" aria-label={label}><slot /></div>
<style>
  .toolbar {
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    border-radius: 24px;
    padding: 0.75rem;
    text-shadow: 0 1px 1px rgb(255 255 255 / 70%);
    background-color: rgb(240 240 240 / 90%);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 30%),
      0 4px 4px -2px rgb(0 0 0 / 20%),
      inset 0 0 1px 1px rgb(255 255 255 / 50%);
    font-size: 1rem;
    line-height: 1rlh;
    z-index: 1;
  }
</style>
