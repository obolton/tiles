---
interface Props {
  id: string;
  axis?: "x" | "y";
  width?: string;
  height?: string;
}

const { id, axis = "x", width, height } = Astro.props;
---

<div
  id={id}
  class:list={["flippable", axis === "x" ? "x-axis" : "y-axis"]}
  data-animate="true"
>
  <div class="face"><slot name="front" /></div>
  <div class="face back"><slot name="back" /></div>
</div>

<style define:vars={{ width, height }}>
  .flippable {
    position: relative;
    width: var(--width, 100%);
    height: var(--height, 100%);
    transform-style: preserve-3d;
    transform-origin: center;

    --perspective: 200px;

    transform: perspective(var(--perspective)) rotateX(0) rotateY(0);
  }

  .back {
    display: none;
    transform: rotateX(180deg);
  }

  .flippable[data-animate="true"] {
    transition: transform var(--animation-duration) var(--easing);
  }

  .flippable[data-animate="true"] .back {
    transition: display var(--animation-duration) allow-discrete;
  }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }

  .flippable[data-flipped="true"] .back {
    display: block;
  }

  .x-axis[data-flipped="true"] {
    transform: perspective(var(--perspective)) rotateX(180deg);
  }

  .y-axis[data-flipped="true"] {
    transform: perspective(var(--perspective)) rotateY(180deg);
  }
</style>
