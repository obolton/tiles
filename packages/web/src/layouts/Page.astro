---
import "@/styles/global.css";
import "@/styles/editing.css";
import "@/styles/buttons.css";
import "@/styles/forms.css";
import "@/styles/drag.css";
import "@/styles/resize.css";
import "@/styles/lightbox.css";
import "@/styles/popovers.css";
import "@/styles/menus.css";
import "@/styles/toasts.css";
import "@/styles/images.css";
import "@/styles/fonts.css";

interface Props {
  id?: string;
  title: string;
  hue?: number | null;
}

const { id, title, hue } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Lora:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <script src="@/components/webComponents.ts"></script>
    <title>{title}</title>
  </head>
  <body
    data-page-id={id}
    data-disable-transitions="true"
    class={typeof hue === "number" ? "color" : undefined}
    style={typeof hue === "number"
      ? {
          "--page-hue": `${hue.toFixed(2)}deg`,
        }
      : undefined}
  >
    <header>
      <slot name="menu" />
      <slot name="header" />
    </header>
    <main><slot /></main>
    <toast-container></toast-container>
    <slot name="end" />
    <script is:inline>
      window.addEventListener(
        "DOMContentLoaded",
        () => {
          delete document.body.dataset.disableTransitions;
        },
        { once: true }
      );
    </script>
    <script>
      import { isSignedIn } from "@/utils/sessions";
      import { initialize } from "@/utils/lightbox";
      if (isSignedIn()) {
        document.body.dataset.signedIn = "true";
      }
      initialize();
    </script>
  </body>
</html>
