---
import Navigation from "@/components/menu/Navigation";
import SignIn from "@/components/menu/SignIn";
import "@/styles/global.css";
import "@/styles/editing.css";
import "@/styles/buttons.css";
import "@/styles/forms.css";
import "@/styles/drag.css";
import "@/styles/resize.css";
import "@/styles/lightbox.css";
import "@/styles/popovers.css";
import "@/styles/navigation.css";
import "@/styles/toasts.css";
import "@/styles/images.css";
import "@/styles/animation.css";
import "@/styles/tabs.css";
import "@/styles/carousels.css";
import "@/styles/tooltips.css";
import "@/styles/richText.css";
import type { Theme } from "@/types/pages";
import { DEFAULT_FONT, type FontId } from "@/config/fonts";
import { getGoogleFontsUrl, getFontConfig } from "@/utils/fonts";
import SpeculationRules from "@/components/resources/SpeculationRules.astro";

interface Props {
  id?: string;
  title: string;
  theme?: Theme;
  hue?: number | null;
  font?: FontId;
  author?: string | null;
  description?: string | null;
  showSignIn?: boolean;
  showTableOfContents?: boolean;
}

const {
  id,
  title,
  theme = "LIGHT",
  hue,
  font = DEFAULT_FONT,
  author,
  description,
  showSignIn = true,
  showTableOfContents,
} = Astro.props;
const fontConfig = font ? getFontConfig(font) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={getGoogleFontsUrl()} rel="stylesheet" />
    <meta name="viewport" content="width=device-width" />
    {author ? <meta name="author" content={author} /> : null}
    {description ? <meta name="description" content={description} /> : null}
    <script src="@/global.ts"></script>
    <title>{title}</title>
  </head>
  <body
    data-page-id={id}
    data-disable-transitions="true"
    class={theme === "LIGHT" ? "light" : theme === "DARK" ? "dark" : "color"}
    style={{
      "--page-hue":
        theme === "COLOR" && typeof hue === "number"
          ? `${hue.toFixed(2)}deg`
          : undefined,
      "--font": fontConfig
        ? `"${fontConfig.family}", "${fontConfig.fallback}"`
        : undefined,
    }}
  >
    <Navigation showTableOfContents={showTableOfContents} />
    {showSignIn ? <SignIn /> : null}

    <slot />

    <toast-container></toast-container>

    <script is:inline>
      window.addEventListener(
        "DOMContentLoaded",
        () => {
          delete document.body.dataset.disableTransitions;
        },
        { once: true }
      );
    </script>
    <script>
      import { isSignedIn } from "@/utils/sessions";
      import { initialize } from "@/utils/lightbox";
      if (isSignedIn()) {
        document.body.dataset.signedIn = "true";
      }
      initialize();
    </script>
    <SpeculationRules />
  </body>
</html>
