---
import "@/styles/global.css";
import "@/styles/editing.css";
import "@/styles/buttons.css";
import "@/styles/drag.css";
import "@/styles/resize.css";
import "@/styles/lightbox.css";

interface Props {
  title: string;
  hue?: number | null;
}

const { title, hue } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <script src="@/utils/binding.ts"></script>
    <title>{title}</title>
  </head>
  <body
    data-disable-transitions="true"
    class={typeof hue === "number" ? "color" : undefined}
    style={typeof hue === "number"
      ? {
          "--page-hue": `${hue.toFixed(2)}deg`,
        }
      : undefined}
  >
    <header>
      <slot name="menu" />
      <slot name="header" />
    </header>
    <main><slot /></main>
    <slot name="end" />
    <script is:inline>
      window.addEventListener(
        "DOMContentLoaded",
        () => {
          delete document.body.dataset.disableTransitions;
        },
        { once: true }
      );
    </script>
    <script>
      import { isSignedIn } from "@/utils/sessions";
      import { initialize } from "@/utils/lightbox";
      if (isSignedIn()) {
        document.body.dataset.signedIn = "true";
      }
      initialize();
    </script>
  </body>
</html>
