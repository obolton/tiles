---
import "../styles/drag.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body data-disable-transitions="true">
    <header><slot name="header" /></header>
    <main><slot /></main>
  </body>
</html>
<style is:global>
  :root {
    --focus-ring-color: #0070f3;
  }

  * {
    box-sizing: border-box;
    margin: 0;
  }

  html,
  body,
  input,
  textarea {
    font-family: system-ui, sans-serif;
  }

  header,
  main {
    margin: 0 auto;
    max-width: 1024px;
  }

  header {
    padding: 48px 0;
  }

  main {
    padding-bottom: 96px;
  }

  body[data-disable-transitions] * {
    transition: none !important;
    animation-name: none !important;
  }

  .editable {
    outline: 4px solid transparent;
    outline-offset: 0px;
    transition: outline-color 0.2s ease;
  }

  body[data-editing] .editable {
    outline-color: rgba(0, 0, 0, 0.1);
  }

  body[data-editing] .editable:focus-within {
    outline-color: var(--focus-ring-color);
  }

  body:has(dialog[open]) {
    overflow: hidden;
  }

  button.primary,
  button.secondary {
    border-radius: 24px;
    font-size: 16px;
    line-height: 16px;
    font-weight: 600;
    cursor: pointer;
    padding: 12px 20px;
    min-width: 120px;
    box-shadow:
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.3),
      0 5px 3px -3px rgba(0, 0, 0, 0.3);
    transition:
      opacity 0.1s ease-in-out,
      transform 0.1s ease-in-out,
      box-shadow 0.1s ease-in-out;
  }

  button.primary:focus-visible,
  button.secondary:focus-visible {
    outline: var(--focus-ring-color) solid 3px;
  }

  button.primary:disabled,
  button.primary[aria-disabled="true"],
  button.secondary:disabled,
  button.secondary[aria-disabled="true"] {
    cursor: default;
    opacity: 0.5;
  }

  button.primary:enabled:active:not([aria-disabled="true"]),
  button.secondary:enabled:active:not([aria-disabled="true"]) {
    transform: translateY(1px);
    box-shadow:
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.3),
      0 4px 3px -3px rgba(0, 0, 0, 0.3);
  }

  button.primary {
    color: rgba(255, 255, 255, 0.9);
    -webkit-font-smoothing: antialiased;
    border: 1px solid rgba(0, 0, 0, 0.4);
    background: linear-gradient(0deg, #101010, #303030);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.8);
  }

  button.secondary {
    color: rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.4);
    background: linear-gradient(0deg, ##f0f0f0, #b0b0b0);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }

  a {
    color: rgba(0, 0, 0, 0.8);
    font-weight: 500;
    text-decoration: none;
  }
</style>
