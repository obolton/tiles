---
import Page from "@/layouts/Page.astro";
import PagesGrid from "@/components/grid/PagesGrid";
import client from "@/api/client";
import { SESSION_COOKIE_NAME } from "api/src/constants/cookies";

const sessionId = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;

if (!sessionId) {
  return Astro.redirect("/sign-in");
}

const pages = await client.pages.list.query(
  { offset: 0 },
  { context: { sessionId } }
);

if (!pages) {
  return Astro.redirect("/sign-in");
}
---

<Page title="Library - Your pages">
  <header slot="header"><h1>Library</h1></header>

  <nav class="tabs">
    <ol>
      <li aria-selected="true"><a href="/library">Your pages</a></li>
      <li><a href="/library/bookmarks">Bookmarks</a></li>
    </ol>
  </nav>

  <PagesGrid pages={pages} client:load />
</Page>
