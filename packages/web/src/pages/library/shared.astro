---
import Page from "@/layouts/Page.astro";
import SharedPagesGrid from "@/components/grid/SharedPagesGrid";
import client from "@/api/client";
import LibraryIcon from "@/icons/library.svg?jsx";
import PeopleIcon from "@/icons/people.svg?jsx";
import BookmarkIcon from "@/icons/bookmark.svg?jsx";
import TrashIcon from "@/icons/trash.svg?jsx";
import { SESSION_COOKIE_NAME } from "api/src/constants/cookies";

const sessionId = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;

if (!sessionId) {
  return Astro.redirect("/sign-in");
}

const pages = await client.pages.listShared.query(
  { offset: 0 },
  { context: { sessionId } }
);

if (!pages) {
  return Astro.redirect("/sign-in");
}
---

<Page
  title="Library - Shared with you"
  description="A list of pages shared with you in Tiles"
>
  <header><h1>Library</h1></header>

  <main>
    <ul class="tabs" role="navigation">
      <li>
        <a href="/library">
          <LibraryIcon aria-hidden="true" />
          Your pages
        </a>
      </li>
      <li aria-selected="true">
        <a href="/library/shared">
          <PeopleIcon aria-hidden="true" />
          Shared with you
        </a>
      </li>
      <li>
        <a href="/library/bookmarks">
          <BookmarkIcon aria-hidden="true" />
          Bookmarks
        </a>
      </li>
      <li>
        <a href="/library/trash">
          <TrashIcon aria-hidden="true" />
          Trash
        </a>
      </li>
    </ul>

    <SharedPagesGrid pages={pages} client:load />
  </main>
</Page>
