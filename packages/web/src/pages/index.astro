---
import Page from "../layouts/Page.astro";
import Toolbar from "../components/Toolbar.astro";
import Switch from "../components/Switch.astro";
import PageTitle from "../components/header/PageTitle";
import Grid from "../components/Grid.astro";
---

<Page title="Tiles">
  <PageTitle pageId="TODO" title="Tiles" client:edit slot="header" />
  <Toolbar><Switch id="editSwitch" label="Edit" /></Toolbar>
  <Grid />
</Page>
<script>
  import { setEditMode } from "../utils/edit";
  document
    .getElementById("editSwitch")
    ?.addEventListener("change", (event) =>
      setEditMode((event.target as HTMLInputElement).checked)
    );
</script>
