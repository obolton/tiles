---
import Page from "../layouts/Page.astro";
import Menubar from "../components/Menubar.astro";
import Flippable from "../components/Flippable.astro";
import Toolbar from "../components/Toolbar.astro";
import Switch from "../components/Switch.astro";
import PageTitle from "../components/header/PageTitle";
import Grid from "../components/grid/Grid";
import TileTypeSelector from "../components/TileTypeSelector.astro";
import EditTileModal from "../components/modals/EditTileModal";
import client from "../api/client";

const pageId = import.meta.env.PAGE_ID;

const page = await client.pages.getById.query(pageId);
---

<Page title={page.title}>
  <PageTitle pageId={page.id} title={page.title} client:edit slot="header" />

  <Menubar>
    <Flippable id="authentication" axis="x" width="150px">
      <Toolbar id="signIn" label="Account toolbar" slot="front">
        <a href="/sign-in">Sign in</a>
      </Toolbar>
      <Toolbar id="user" label="Account toolbar" slot="back">
        <span id="userName">Anonymous</span>
      </Toolbar>
    </Flippable>

    <Toolbar label="Editing toolbar">
      <Switch id="editSwitch" label="Edit" />
    </Toolbar>
  </Menubar>

  <Grid pageId={pageId} tiles={page.tiles} client:edit>
    <TileTypeSelector />
  </Grid>

  <EditTileModal pageId={pageId} client:edit />
</Page>
<script is:inline>
  if (sessionStorage.getItem("edit")) {
    document.body.dataset.editing = "true";
    document.getElementById("editSwitch").checked = true;
  }
  window.addEventListener(
    "DOMContentLoaded",
    () => {
      delete document.body.dataset.disableTransitions;
    },
    { once: true }
  );
</script>
<script>
  import { setEditMode } from "../utils/edit";
  import {
    isSignedIn,
    getUserInfo,
    getCachedUserInfo,
  } from "../utils/sessions";

  const editSwitch = document.getElementById("editSwitch") as HTMLInputElement;
  editSwitch.addEventListener("change", (event) =>
    setEditMode(editSwitch.checked)
  );

  if (isSignedIn()) {
    const authState = document.getElementById("authentication")!;
    const userName = document.getElementById("userName")!;
    const signIn = document.getElementById("signIn")!;

    const userInfo = getCachedUserInfo();

    if (userInfo) {
      userName.innerText = userInfo.name;
      authState.dataset.animate = "false";
      authState.dataset.flipped = "true";
    } else {
      signIn.innerHTML = "Signing in...";

      Promise.all([
        getUserInfo(),
        new Promise((resolve) => setTimeout(resolve, 1500)),
      ])
        .then(([user]) => {
          userName.innerText = user.name;
          authState.dataset.animate = "true";
          authState.dataset.flipped = "true";
        })
        .catch((error) => {
          console.error(error);
        });
    }
  }
</script>
