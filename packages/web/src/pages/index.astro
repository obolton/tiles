---
import Page from "@/layouts/Page.astro";
import PageHeader from "@/components/header/PageHeader";
import Grid from "@/components/grid/Grid";
import client from "@/api/client";
import { CACHE_CONTROL_VALUE } from "@/constants/cdn";

const pageId = import.meta.env.PAGE_ID;
if (!pageId) {
  throw new Error("PAGE_ID is not set");
}

const page = await client.pages.getById.query({ id: pageId });

if (!page) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

Astro.response.headers.set("Cache-Control", CACHE_CONTROL_VALUE);
---

<Page
  id={page.id}
  title={page.title}
  theme={page.theme}
  hue={page.hue}
  font={page.font}
>
  <PageHeader
    pageId={page.id}
    title={page.title}
    subtitle={page.subtitle}
    coverImageUrl={page.coverImageUrl}
    author={null}
    updatedAt={null}
    slot="header"
  />

  <Grid tiles={page.tiles} />
</Page>
