---
import Page from "@/layouts/Page.astro";
import EditingToolbar from "@/components/menu/EditingToolbar.astro";
import PageHeader from "@/components/header/PageHeader";
import Grid from "@/components/grid/Grid";
import EditTileModal from "@/components/modals/EditTileModal";
import client from "@/api/client";
import { CACHE_CONTROL_VALUE } from "@/constants/cdn";

const pageId = import.meta.env.PAGE_ID;
if (!pageId) {
  throw new Error("PAGE_ID is not set");
}

const page = await client.pages.getById.query({ id: pageId });

if (!page) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

Astro.response.headers.set("Cache-Control", CACHE_CONTROL_VALUE);
---

<Page
  id={page.id}
  title={page.title}
  theme={page.theme}
  hue={page.hue}
  font={page.font}
>
  <EditingToolbar pageId={page.id} allowDelete={false} slot="menu" />

  <PageHeader
    pageId={page.id}
    title={page.title}
    subtitle={page.subtitle}
    slot="header"
    client:edit
  />

  <Grid tiles={page.tiles} client:edit />

  <EditTileModal slot="end" client:edit />
</Page>
