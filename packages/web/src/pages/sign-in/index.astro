---
import Page from "@/layouts/Page.astro";
import { SESSION_COOKIE_NAME } from "api/src/constants/cookies";
import "@/styles/authentication.css";

const sessionId = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;

if (sessionId) {
  return Astro.redirect("/library");
}

const destination = Astro.url.searchParams.get("destination");
const params = destination
  ? `?destination=${encodeURIComponent(destination)}`
  : "";
---

<Page title="Sign in" description="Sign in to Tiles" showSignIn={false}>
  <main class="card">
    <h2>Sign in</h2>
    <p>Select an option below to sign in.</p>
    <a class="primary" href={`/sign-in/google${params}`}>Sign in with Google</a>
  </main>
</Page>
