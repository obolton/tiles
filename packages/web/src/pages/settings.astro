---
import Page from "@/layouts/Page.astro";
import Menu from "@/components/menu/SettingsMenu.astro";
import client from "@/api/client";
import { SESSION_COOKIE_NAME } from "api/src/constants/cookies";

const sessionId = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;

if (!sessionId) {
  return Astro.redirect("/sign-in");
}

const user = await client.auth.getUserInfo.query(undefined, {
  context: { sessionId },
});

if (!user) {
  return Astro.redirect("/sign-in");
}

const ACCEPT_CONTENT_TYPES = ["image/jpeg", "image/png"];
---

<Page title="Settings">
  <Menu slot="menu" />

  <h1 slot="header">Settings</h1>

  <form id="settings-form" class="vertical">
    <input type="hidden" name="id" value={user.id} />

    <file-picker
      id="profile-image-picker"
      type="profile-image"
      accept={ACCEPT_CONTENT_TYPES.join(",")}
    >
      <data-binding src="user.imageUrl" name="user.name">
        <profile-image class="large" data-pending-text=""></profile-image>
      </data-binding>
    </file-picker>

    <label>
      Name
      <input
        type="text"
        name="name"
        value={user.name}
        placeholder="Name"
        required
        maxlength="64"
      />
    </label>

    <label>
      Email address
      <input
        type="email"
        name="email"
        value={user.email}
        placeholder="Email address"
        required
        maxlength="254"
      />
    </label>

    <footer>
      <button class="primary" type="submit">Save</button>
    </footer>
  </form>
</Page>
<script>
  import client from "@/api/client";
  import { setUserInfo } from "@/utils/sessions";
  import { redirectWithToast } from "@/utils/toasts";
  import { getPersistent } from "@/utils/state";
  import { handleError } from "@/utils/errors";
  import type FilePicker from "@/components/forms/FilePicker";

  const filePicker = document.getElementById(
    "profile-image-picker"
  )! as FilePicker;
  const image = filePicker.querySelector("profile-image")!;
  const form = document.getElementById("settings-form")! as HTMLFormElement;

  function getFormData() {
    const formData = new FormData(form);
    return Object.fromEntries(formData.entries()) as {
      id: string;
      name: string;
      email: string;
    };
  }

  filePicker.addEventListener("change", () => image.classList.add("pending"));
  filePicker.addEventListener("error", () => image.classList.remove("pending"));
  image.addEventListener("load", () => image.classList.remove("pending"));

  filePicker.addEventListener("upload", async ({ uploadKey }) => {
    const userInfo = await client.users.update.mutate({
      id: getFormData().id,
      imageKey: uploadKey,
    });
    setUserInfo(userInfo);
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    form.dataset.pending = "true";
    delete form.dataset.error;

    try {
      const userInfo = await client.users.update.mutate(getFormData());
      setUserInfo(userInfo);
      redirectWithToast(
        getPersistent("user.profile") ?? "/",
        "Your settings were saved.",
        "success"
      );
    } catch (error) {
      delete form.dataset.pending;
      form.dataset.error = "true";
      if (error instanceof Error) {
        handleError(error);
      }
    }
  });
</script>
