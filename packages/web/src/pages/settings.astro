---
import Page from "@/layouts/Page.astro";
import client from "@/api/client";
import { SESSION_COOKIE_NAME } from "api/src/constants/cookies";
import { setSearchParams } from "@/utils/urls";

const sessionId = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;

if (!sessionId) {
  return Astro.redirect("/sign-in");
}

const user = await client.auth.getUserInfo.query(undefined, {
  context: { sessionId },
});

if (!user) {
  return Astro.redirect("/sign-in");
}

const ACCEPT_CONTENT_TYPES = ["image/jpeg", "image/png"];
---

<Page title="Settings" description="Your account settings in Tiles">
  <header><h1>Settings</h1></header>

  <main>
    <form id="settings-form" class="vertical">
      <input type="hidden" name="id" value={user.id} />

      <file-picker
        id="profile-image-picker"
        type="profile-image"
        accept={ACCEPT_CONTENT_TYPES.join(",")}
      >
        <img
          id="profile-image"
          class="profile-image large"
          src={setSearchParams(user.imageUrl!, { class: "large" })}
          alt={user.name}
          data-tooltip="Select a new profile image"
          data-tooltip-position="right"
        />
      </file-picker>

      <label>
        Name
        <input
          type="text"
          name="name"
          value={user.name}
          placeholder="Name"
          required
          maxlength="64"
        />
      </label>

      <label>
        Username
        <input
          id="username"
          type="text"
          name="username"
          value={user.username ?? ""}
          placeholder="Username"
          minlength="2"
          maxlength="30"
          pattern="[a-zA-Z0-9\\-]{2,30}"
        />
      </label>

      <label>
        Email address
        <input
          type="email"
          name="email"
          value={user.email}
          placeholder="Email address"
          required
          maxlength="254"
        />
      </label>

      <footer>
        <button class="primary" type="submit">Save</button>
      </footer>
    </form>
  </main>
</Page>
<script>
  import client from "@/api/client";
  import { setUserInfo } from "@/utils/sessions";
  import { redirectWithToast } from "@/utils/toasts";
  import { getPersistent } from "@/utils/state";
  import { handleError } from "@/utils/errors";
  import { setSearchParams } from "@/utils/urls";
  import { uploadMedia } from "@/utils/media";
  import type FilePicker from "@/components/forms/FilePicker";

  const filePicker = document.getElementById(
    "profile-image-picker"
  )! as FilePicker;
  const image = document.getElementById("profile-image")! as HTMLImageElement;
  const form = document.getElementById("settings-form")! as HTMLFormElement;
  const username = document.getElementById("username")! as HTMLInputElement;

  function getFormData() {
    const formData = new FormData(form);
    return Object.fromEntries(formData.entries()) as {
      id: string;
      username: string;
      name: string;
      email: string;
    };
  }

  filePicker.addEventListener("change", async () => {
    try {
      const file = filePicker.file;
      if (!file) {
        return;
      }
      const url = URL.createObjectURL(file);
      image.src = url;
      const imageKey = await uploadMedia(file, "profile-image");
      const userInfo = await client.users.update.mutate({ imageKey });
      setUserInfo(userInfo);
      image.src = setSearchParams(userInfo.imageUrl!, { class: "large" })!;
      URL.revokeObjectURL(url);
    } catch (error) {
      handleError(error);
    }
  });

  username.addEventListener("input", async () => {
    const value = username.value;
    const validity = username.validity;

    if (validity.tooShort) {
      username.setCustomValidity("Usernames must be at least 2 characters.");
    } else if (validity.tooLong) {
      username.setCustomValidity(
        "Usernames must be no more than 30 characters."
      );
    } else if (validity.patternMismatch) {
      username.setCustomValidity(
        "Usernames can contain only letters, numbers and dashes."
      );
    } else if (validity.valid && value.length > 0) {
      const isAvailable = await client.users.isUsernameAvailable.query({
        username: value,
      });
      username.setCustomValidity(
        isAvailable ? "" : "This username is already taken."
      );
    } else {
      username.setCustomValidity("");
    }
    username.reportValidity();
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    form.dataset.pending = "true";
    delete form.dataset.error;

    try {
      const formData = getFormData();
      const userInfo = await client.users.update.mutate({
        ...formData,
        username: formData.username || null,
      });
      setUserInfo(userInfo);
      redirectWithToast(
        getPersistent("user.profile") ?? "/",
        "Your settings were saved.",
        "success"
      );
    } catch (error) {
      delete form.dataset.pending;
      form.dataset.error = "true";
      handleError(error);
    }
  });
</script>
