---
import Page from "@/layouts/Page.astro";
import EditingToolbar from "@/components/menu/EditingToolbar.astro";
import ProfilePageHeader from "@/components/header/ProfilePageHeader";
import Grid from "@/components/grid/Grid";
import client from "@/api/client";
import { CACHE_CONTROL_VALUE } from "@/constants/cdn";

const { id } = Astro.params;

if (!id) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

const username = id.startsWith("@") ? id.slice(1) : null;
const profile = await client.pages.getProfilePage.query(
  username ? { username } : { userId: id }
);

if (!profile) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

Astro.response.headers.set("Cache-Control", CACHE_CONTROL_VALUE);
---

<Page
  id={profile.profilePage.id}
  title={profile.name}
  theme={profile.profilePage.theme}
  hue={profile.profilePage.hue}
  font={profile.profilePage.font}
>
  <EditingToolbar
    isPublished
    allowDelete={false}
    allowPublish={false}
    slot="menu"
  />

  <ProfilePageHeader
    name={profile.name}
    imageUrl={profile.imageUrl}
    subtitle={profile.profilePage.subtitle}
    slot="header"
    client:edit
  />

  <Grid tiles={profile.profilePage.tiles} client:edit />
</Page>
