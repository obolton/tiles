---
import Page from "@/layouts/Page.astro";
import EditableProfilePage from "@/components/pages/EditableProfilePage";
import client from "@/api/client";
import { CACHE_CONTROL_VALUE } from "@/constants/cdn";

const { id } = Astro.params;

if (!id) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

const username = id.startsWith("@") ? id.slice(1) : null;
const user = await client.pages.getProfilePage.query(
  username ? { username } : { userId: id }
);

if (!user) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

Astro.response.headers.set("Cache-Control", CACHE_CONTROL_VALUE);
---

<Page
  id={user.profilePage.id}
  title={user.name}
  theme={user.profilePage.theme}
  hue={user.profilePage.hue}
  font={user.profilePage.font}
>
  <EditableProfilePage user={user} client:edit />
  <script src="@/init.ts"></script>
</Page>
