---
import Page from "@/layouts/Page.astro";
import Menu from "@/components/menu/PageMenu.astro";
import ProfilePageHeader from "@/components/header/ProfilePageHeader";
import Grid from "@/components/grid/Grid";
import EditTileModal from "@/components/modals/EditTileModal";
import client from "@/api/client";

const { id: userId } = Astro.params;

if (!userId) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

const profile = await client.pages.getProfilePageByUserId.query({ userId });
if (!profile) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}
---

<Page
  id={profile.profilePage.id}
  title={profile.name}
  theme={profile.profilePage.theme}
  hue={profile.profilePage.hue}
  font={profile.profilePage.font}
>
  <Menu pageId={profile.profilePage.id} allowDelete={false} slot="menu" />

  <ProfilePageHeader
    pageId={profile.profilePage.id}
    name={profile.name}
    imageUrl={profile.imageUrl}
    subtitle={profile.profilePage.subtitle}
    slot="header"
    client:edit
  />

  <Grid tiles={profile.profilePage.tiles} client:edit />

  <EditTileModal pageId={profile.profilePage.id} slot="end" client:edit />
</Page>
