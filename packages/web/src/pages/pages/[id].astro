---
import Page from "@/layouts/Page.astro";
import EditablePage from "@/components/pages/EditablePage";
import client from "@/api/client";
import { CACHE_CONTROL_VALUE } from "@/constants/cdn";
import { SESSION_COOKIE_NAME } from "api/src/constants/cookies";

const { id: pageId } = Astro.params;

const sessionId = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;

if (!pageId) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

const page = await client.pages.getById.query(
  { id: pageId },
  { context: { sessionId } }
);
if (!page) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

if (page.published) {
  Astro.response.headers.set("Cache-Control", CACHE_CONTROL_VALUE);
}
---

<Page
  id={page.id}
  title={page.title}
  theme={page.theme}
  hue={page.hue}
  font={page.font}
  author={page.author.name}
  description={page.subtitle
    ? `${page.subtitle} - Tiles`
    : `A page by ${page.author.name} - Tiles`}
>
  <script src="@/init.ts"></script>
  <EditablePage page={page} client:edit />
</Page>
