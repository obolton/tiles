---
import Page from "@/layouts/Page.astro";
import EditingToolbar from "@/components/menu/EditingToolbar.astro";
import PageHeader from "@/components/header/PageHeader";
import PageMetadata from "@/components/header/PageMetadata";
import Grid from "@/components/grid/Grid";
import client from "@/api/client";
import { CACHE_CONTROL_VALUE } from "@/constants/cdn";
import { SESSION_COOKIE_NAME } from "api/src/constants/cookies";
import { getTileFonts } from "@/utils/pageFonts";
import { DEFAULT_FONT } from "@/config/fonts";

const { id: pageId } = Astro.params;

const sessionId = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;

if (!pageId) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

const page = await client.pages.getById.query(
  { id: pageId },
  { context: { sessionId } }
);
if (!page) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

if (page.published) {
  Astro.response.headers.set("Cache-Control", CACHE_CONTROL_VALUE);
}

const fonts = getTileFonts(page.tiles);
fonts.add(page.font);
fonts.add(DEFAULT_FONT);
---

<Page
  id={page.id}
  title={page.title}
  theme={page.theme}
  hue={page.hue}
  font={page.font}
  allFonts={fonts}
>
  <EditingToolbar pageId={page.id} isPublished={page.published} slot="menu" />

  <PageHeader
    pageId={page.id}
    title={page.title}
    subtitle={page.subtitle}
    slot="header"
    client:edit
  />

  <PageMetadata
    id={page.author.id}
    name={page.author.name}
    imageUrl={page.author.imageUrl}
    updatedAt={page.updatedAt}
    slot="header"
  />

  <Grid tiles={page.tiles} client:edit />
</Page>
