---
import Page from "@/layouts/Page.astro";
import Menu from "@/components/menu/PageMenu.astro";
import PageHeader from "@/components/header/PageHeader";
import Author from "@/components/header/Author";
import Grid from "@/components/grid/Grid";
import EditTileModal from "@/components/modals/EditTileModal";
import client from "@/api/client";

const { id: pageId } = Astro.params;

if (!pageId) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}

const page = await client.pages.getById.query({ id: pageId });
if (!page) {
  return new Response(null, {
    status: 404,
    statusText: "Page not found",
  });
}
---

<Page id={page.id} title={page.title} hue={page.hue}>
  <Menu pageId={page.id} slot="menu" />

  <PageHeader
    pageId={page.id}
    title={page.title}
    subtitle={page.subtitle}
    slot="header"
    client:edit
  />

  <Author
    id={page.author.id}
    name={page.author.name}
    imageUrl={page.author.imageUrl}
    slot="header"
  />

  <Grid tiles={page.tiles} client:edit />

  <EditTileModal pageId={page.id} slot="end" client:edit />
</Page>
