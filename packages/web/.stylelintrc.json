{
  "extends": ["stylelint-config-standard", "stylelint-config-html/astro"],
  "rules": {
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ],
    "selector-type-no-unknown": [
      true,
      {
        "ignore": ["custom-elements"],
        "ignoreTypes": ["expanded", "overlay"]
      }
    ]
  }
}
