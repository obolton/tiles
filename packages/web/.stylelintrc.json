{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ],
    "selector-type-no-unknown": [
      true,
      {
        "ignore": ["custom-elements"],
        "ignoreTypes": ["expanded", "overlay", "resizing", "scrollable"]
      }
    ],
    "declaration-property-value-disallowed-list": [
      {
        "/^(animation|transition)(-duration)?$/": [
          "/(^|[\\s,(])(\\d*[1-9]\\d*(\\.\\d+)?|\\d*\\.\\d*[1-9]\\d*)m?s\\b/"
        ]
      },
      {
        "message": "Derive durations from the --animation-duration properties so that they respect prefers-reduced-motion. Set literal delays with the -delay longhand."
      }
    ],
    "length-zero-no-unit": null,
    "no-descending-specificity": null
  }
}
