{
  "name": "fonts",
  "version": "0.0.1",
  "private": true,
  "description": "Font registry, manifest and sync script",
  "type": "module",
  "exports": {
    "./*.json": "./src/*.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "sync": "tsx --env-file-if-exists=\"../../../.env\" scripts/sync.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/subset-font": "^2.3.0",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "wrangler": "^4.148.0"
  }
}
