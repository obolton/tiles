{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "image-upload-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "tiles-dev-images",
      "remote": true,
    },
  ],
  "dev": {
    "ip": "0.0.0.0",
    "port": 3002,
    "local_protocol": "http",
  },
}
