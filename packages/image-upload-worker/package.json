{
  "name": "image-upload-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Image upload worker",
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_INCLUDE_PROCESS_ENV=true wrangler dev --persist-to ../../.wrangler/state",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "typecheck": "tsc --build",
    "generate": "wrangler types src/worker.d.ts"
  },
  "dependencies": {
    "@trpc/client": "^11.19.0",
    "api": "workspace:*",
    "cookie": "^2.0.1",
    "image-dimensions": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "wrangler": "^4.148.0"
  }
}
