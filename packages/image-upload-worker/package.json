{
  "name": "image-upload-worker",
  "type": "module",
  "version": "0.0.1",
  "description": "Image upload worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --https-cert-path ../../localhost.pem --https-key-path ../../localhost-key.pem",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "tsc": "tsc --build",
    "generate-worker-types": "wrangler types src/worker.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@trpc/client": "^11.5.1",
    "api": "workspace:*",
    "cookie": "^1.1.1"
  },
  "devDependencies": {
    "wrangler": "^4.44.0"
  }
}
