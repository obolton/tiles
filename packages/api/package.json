{
  "name": "api",
  "type": "module",
  "version": "0.0.1",
  "description": "API",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=\"../../.env\" --clear-screen=false src/index.ts",
    "build": "prisma generate && esbuild src/index.ts --bundle --outdir=dist --platform=node --target=node24 --packages=external --format=esm",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "db:generate-client": "prisma generate --no-hints",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "cdn:purge": "tsx --env-file=\"../../.env\" scripts/purge-cdn.ts",
    "tsc": "tsc --build"
  },
  "prisma": {
    "schema": "./prisma/schema",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.846.0",
    "@aws-sdk/client-sesv2": "^3.846.0",
    "@aws-sdk/lib-storage": "^3.846.0",
    "@aws-sdk/s3-request-presigner": "^3.846.0",
    "@prisma/client": "^6.14.0",
    "@trpc/server": "^11.4.3",
    "cloudflare": "^4.5.0",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "fractional-indexing": "^3.2.0",
    "htmlparser2": "^10.0.0",
    "openai": "^5.15.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.18",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.6",
    "prisma": "^6.14.0",
    "prisma-json-types-generator": "^3.5.4",
    "tsx": "^4.20.3"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
