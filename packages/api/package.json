{
  "name": "api",
  "type": "module",
  "version": "0.0.1",
  "description": "API",
  "private": true,
  "exports": {
    "./*.json": "./src/*.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=\"../../../.env\" --clear-screen=false src/index.ts",
    "build": "pnpm db:generate-client && esbuild src/index.ts --bundle --outdir=dist --platform=node --target=node24 --packages=external --format=esm",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "generate": "prisma generate --no-hints",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "cdn:purge": "tsx --env-file=\"../../../.env\" scripts/purge-cdn.ts",
    "fonts:sync": "tsx --env-file=\"../../../.env\" scripts/sync-fonts.ts",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/client-sesv2": "^3.1014.0",
    "@aws-sdk/lib-storage": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1014.0",
    "@hocuspocus/server": "^4.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@trpc/server": "^11.16.0",
    "cloudflare": "^5.1.0",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "crossws": "^0.4.5",
    "doc": "workspace:*",
    "htmlparser2": "^12.0.0",
    "openai": "6.32.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/node": "^24.3.0",
    "@types/subset-font": "^2.3.0",
    "esbuild": "^0.28.0",
    "prisma": "^7.8.0",
    "subset-font": "^2.5.0",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
