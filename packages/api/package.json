{
  "name": "api",
  "type": "module",
  "version": "0.0.1",
  "description": "API",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=\"../../../.env\" --clear-screen=false src/index.ts",
    "build": "pnpm db:generate-client && esbuild src/index.ts --bundle --outdir=dist --platform=node --target=node24 --packages=external --format=esm",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "generate": "prisma generate --no-hints --sql",
    "db:push": "prisma db push",
    "db:push-functions": "prisma db execute --file src/sql/functions/duplicate_tile.sql",
    "db:seed": "prisma db seed",
    "cdn:purge": "tsx --env-file=\"../../../.env\" scripts/purge-cdn.ts",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.890.0",
    "@aws-sdk/client-sesv2": "^3.890.0",
    "@aws-sdk/lib-storage": "^3.890.0",
    "@aws-sdk/s3-request-presigner": "^3.890.0",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@trpc/server": "^11.8.1",
    "cloudflare": "^5.1.0",
    "cookie": "^1.1.1",
    "cors": "^2.8.5",
    "fractional-indexing": "^3.2.0",
    "htmlparser2": "^10.0.0",
    "openai": "^6.23.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/node": "^24.3.0",
    "esbuild": "^0.27.3",
    "prisma": "^7.4.1",
    "prisma-json-types-generator": "^4.1.0",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
