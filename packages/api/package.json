{
  "name": "api",
  "type": "module",
  "version": "0.0.1",
  "description": "API",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=\"../../.env\" --clear-screen=false src/index.ts",
    "build": "prisma generate && esbuild src/index.ts --bundle --outdir=dist --platform=node --target=node21 --packages=external --format=esm",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "db:generate-client": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/client-sesv2": "^3.693.0",
    "@aws-sdk/lib-storage": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.693.0",
    "@prisma/client": "^6.0.1",
    "@trpc/server": "^11.0.0-rc.374",
    "cloudflare": "^3.5.0",
    "cookie": "^1.0.1",
    "cors": "^2.8.5",
    "htmlparser2": "^9.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "prisma": "^6.0.1",
    "prisma-json-types-generator": "^3.2.2",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=21"
  }
}
