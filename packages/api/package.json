{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "description": "API",
  "type": "module",
  "exports": {
    "./*.json": "./src/*.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=\"../../../.env\" --clear-screen=false src/index.ts",
    "build": "pnpm db:generate-client && esbuild src/index.ts --bundle --outdir=dist --platform=node --target=node24 --packages=external --format=esm",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "generate": "prisma generate --no-hints",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "cdn:purge": "tsx --env-file=\"../../../.env\" scripts/purge-cdn.ts",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/client-sesv2": "^3.1148.0",
    "@aws-sdk/lib-storage": "^3.1148.0",
    "@hocuspocus/server": "^4.7.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@trpc/server": "^11.19.0",
    "cloudflare": "^7.3.0",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "crossws": "^0.4.15",
    "doc": "workspace:*",
    "fonts": "workspace:*",
    "htmlparser2": "^12.0.0",
    "openai": "6.32.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "prisma": "^7.9.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
