generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  imageKey      String?  @map("image_key")
  profilePageId String   @unique @map("profile_page_id") @db.Uuid

  sessions    Session[]
  keys        Key[]
  profilePage Page       @relation("ProfilePage", fields: [profilePageId], references: [id], onDelete: Cascade)
  pages       Page[]     @relation("Pages")
  bookmarks   Bookmark[]

  @@map("users")
}

enum AuthenticationProvider {
  GOOGLE
  APPLE
}

model Key {
  createdAt  DateTime               @default(now()) @map("created_at")
  provider   AuthenticationProvider
  providerId String                 @map("provider_id")
  userId     String                 @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id(name: "id", [provider, providerId])
  @@index([userId])
  @@map("keys")
}

model Session {
  id        String   @id @db.VarChar(88)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum Theme {
  LIGHT
  DARK
  COLOR
}

enum Font {
  MODERN
  CLASSIC
  CODE
  ROUNDED
  BUBBLES
}

model Page {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  authorId  String   @map("author_id") @db.Uuid
  published Boolean  @default(false)
  title     String
  subtitle  String?
  theme     Theme    @default(LIGHT) @map("theme")
  hue       Float?   @db.Real
  font      Font     @default(MODERN)

  author        User           @relation("Pages", fields: [authorId], references: [id], onDelete: Cascade)
  profileUser   User?          @relation("ProfilePage")
  tiles         Tile[]
  pageLinkTiles PageLinkTile[]
  bookmarks     Bookmark[]

  @@index([authorId])
  @@index([authorId, updatedAt])
  @@map("pages")
}

enum TileType {
  IMAGE
  VIDEO
  TEXT
  PLACE
  LINK
  HEADING
  PAGE_LINK
  EVENT
  COLLECTION
  MAP
}

model Tile {
  id                 String   @id @default(uuid()) @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  pageId             String   @map("page_id") @db.Uuid
  position           Int
  columns            Int      @default(1) @db.SmallInt
  rows               Int      @default(1) @db.SmallInt
  imageTileId        String?  @map("image_tile_id") @db.Uuid
  videoTileId        String?  @map("video_tile_id") @db.Uuid
  textTileId         String?  @map("text_tile_id") @db.Uuid
  mapTileId          String?  @map("map_tile_id") @db.Uuid
  linkTileId         String?  @map("link_tile_id") @db.Uuid
  headingTileId      String?  @map("heading_tile_id") @db.Uuid
  pageLinkTileId     String?  @map("page_link_tile_id") @db.Uuid
  eventTileId        String?  @map("event_tile_id") @db.Uuid
  collectionId       String?  @map("collection_id") @db.Uuid
  parentCollectionId String?  @map("parent_collection_id") @db.Uuid

  page             Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentCollection Collection?   @relation("ParentCollection", fields: [parentCollectionId], references: [id], onDelete: SetNull)
  type             TileType
  image            ImageTile?    @relation(fields: [imageTileId], references: [id], onDelete: SetNull)
  video            VideoTile?    @relation(fields: [videoTileId], references: [id], onDelete: SetNull)
  text             TextTile?     @relation(fields: [textTileId], references: [id], onDelete: SetNull)
  map              MapTile?      @relation(fields: [mapTileId], references: [id], onDelete: SetNull)
  link             LinkTile?     @relation(fields: [linkTileId], references: [id], onDelete: SetNull)
  heading          HeadingTile?  @relation(fields: [headingTileId], references: [id], onDelete: SetNull)
  pageLink         PageLinkTile? @relation(fields: [pageLinkTileId], references: [id], onDelete: SetNull)
  event            EventTile?    @relation(fields: [eventTileId], references: [id], onDelete: SetNull)
  collection       Collection?   @relation("CollectionTile", fields: [collectionId], references: [id], onDelete: SetNull)

  @@map("tiles")
}

model ImageTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  imageKey  String   @map("image_key")
  caption   String?
  originX   Float    @default(0.5) @map("origin_x") @db.Real
  originY   Float    @default(0.5) @map("origin_y") @db.Real

  tiles Tile[]

  @@map("image_tiles")
}

enum VideoType {
  YOUTUBE
}

model VideoTile {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  videoType   VideoType @map("video_type")
  videoId     String    @map("video_id")
  imageUrl    String?   @map("image_url")
  title       String
  description String?

  tiles Tile[]

  @@map("video_tiles")
}

model TextTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// [RichText]
  content Json   @db.JsonB
  theme   Theme?
  hue     Float? @db.Real

  tiles Tile[]

  @@map("text_tiles")
}

model Place {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  name        String
  lat         Float
  long        Float
  boundingBox Float[]  @map("bounding_box")
  address     String?
  providerId  String?  @map("provider_id")
  mapTileId   String   @map("map_tile_id") @db.Uuid

  map MapTile @relation(fields: [mapTileId], references: [id], onDelete: Cascade)

  @@map("places")
}

model MapTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tiles  Tile[]
  places Place[]

  @@map("map_tiles")
}

model LinkTile {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  url         String
  title       String?
  description String?
  siteName    String?  @map("site_name")
  imageUrl    String?  @map("image_url")

  tiles Tile[]

  @@map("link_tiles")
}

model HeadingTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  content   String

  tiles Tile[]

  @@map("heading_tiles")
}

model PageLinkTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pageId    String?  @map("page_id") @db.Uuid

  page  Page?  @relation(fields: [pageId], references: [id], onDelete: SetNull)
  tiles Tile[]

  @@map("page_link_tiles")
}

model EventTile {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  title     String?
  start     DateTime  @db.Timestamp(0)
  end       DateTime? @db.Timestamp(0)
  allDay    Boolean   @default(false) @map("all_day")
  timeZone  String?   @map("time_zone")

  tiles Tile[]

  @@map("event_tiles")
}

model Collection {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  title     String?

  tiles Tile[] @relation("CollectionTile")
  items Tile[] @relation("ParentCollection")

  @@map("collections")
}

model Bookmark {
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id") @db.Uuid
  pageId    String   @map("page_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id(name: "bookmarkId", [userId, pageId])
  @@index([userId])
  @@map("bookmarks")
}
