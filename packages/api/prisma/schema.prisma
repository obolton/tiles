generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  imageUrl      String?  @map("image_url")
  profilePageId String   @unique @map("profile_page_id") @db.Uuid

  sessions    Session[]
  keys        Key[]
  profilePage Page      @relation("ProfilePage", fields: [profilePageId], references: [id])
  pages       Page[]    @relation("Pages")

  @@map("users")
}

enum AuthenticationProvider {
  GOOGLE
  APPLE
}

model Key {
  createdAt  DateTime               @default(now()) @map("created_at")
  provider   AuthenticationProvider
  providerId String                 @map("provider_id")
  userId     String                 @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id(name: "id", [provider, providerId])
  @@index([userId])
  @@map("keys")
}

model Session {
  id        String   @id @db.VarChar(88)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Page {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  title     String
  subtitle  String?
  authorId  String   @map("author_id") @db.Uuid

  author        User           @relation("Pages", fields: [authorId], references: [id])
  profileUser   User?          @relation("ProfilePage")
  tiles         Tile[]
  pageLinkTiles PageLinkTile[]

  @@map("pages")
}

enum TileType {
  IMAGE
  TEXT
  PLACE
  LINK
  HEADING
  PAGE_LINK
}

model Tile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pageId    String   @map("page_id") @db.Uuid
  position  Int
  columns   Int      @default(1) @db.SmallInt
  rows      Int      @default(1) @db.SmallInt

  page     Page          @relation(fields: [pageId], references: [id])
  type     TileType
  image    ImageTile?
  text     TextTile?
  place    PlaceTile?
  link     LinkTile?
  heading  HeadingTile?
  pageLink PageLinkTile?

  @@map("tiles")
}

model ImageTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tileId    String   @unique @map("tile_id") @db.Uuid
  imageKey  String   @map("image_key")
  caption   String?

  tile Tile @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@map("image_tiles")
}

model TextTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tileId    String   @unique @map("tile_id") @db.Uuid
  content   String

  tile Tile @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@map("text_tiles")
}

model PlaceTile {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tileId       String   @unique @map("tile_id") @db.Uuid
  name         String
  lat          Float
  long         Float
  boundingBox  Float[]  @map("bounding_box")
  address      String?
  providerId   String?  @map("provider_id")
  thumbnailKey String   @map("thumbnail_key")

  tile Tile @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@map("place_tiles")
}

model LinkTile {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tileId      String   @unique @map("tile_id") @db.Uuid
  url         String
  title       String?
  description String?
  siteName    String?  @map("site_name")
  imageUrl    String?  @map("image_url")

  tile Tile @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@map("link_tiles")
}

model HeadingTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tileId    String   @unique @map("tile_id") @db.Uuid
  content   String

  tile Tile @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@map("heading_tiles")
}

model PageLinkTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tileId    String   @unique @map("tile_id") @db.Uuid
  pageId    String?  @map("page_id") @db.Uuid

  tile Tile  @relation(fields: [tileId], references: [id], onDelete: Cascade)
  page Page? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@map("page_link_tiles")
}
