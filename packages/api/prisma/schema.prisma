generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  name      String
  email     String   @unique

  pages Page[]

  @@map("users")
}

model Page {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  title     String
  authorId  String   @map("author_id") @db.Uuid

  author User   @relation(fields: [authorId], references: [id])
  tiles  Tile[]

  @@map("pages")
}

enum TileType {
  IMAGE
  TEXT
}

model Tile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pageId    String   @map("page_id") @db.Uuid
  position  Int

  page  Page       @relation(fields: [pageId], references: [id])
  type  TileType
  image ImageTile?
  text  TextTile?

  @@map("tiles")
}

model ImageTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tileId    String   @unique @map("tile_id") @db.Uuid
  imageKey  String   @map("image_key")

  tile Tile @relation(fields: [tileId], references: [id])

  @@map("image_tiles")
}

model TextTile {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tileId    String   @unique @map("tile_id") @db.Uuid
  content   String

  tile Tile @relation(fields: [tileId], references: [id])

  @@map("text_tiles")
}
