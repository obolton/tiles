enum Font {
  MODERN
  CLASSIC
  CODE
  ROUNDED
  BUBBLES
}

enum CollectionType {
  SECTION
  TILE
}

enum CollectionWidth {
  DEFAULT
  VIEWPORT
}

model Page {
  id            String    @id @default(uuid()) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  authorId      String    @map("author_id") @db.Uuid
  published     Boolean   @default(false)
  title         String
  subtitle      String?
  lightness     Float     @default(1) @db.Real
  chroma        Float     @default(0) @db.Real
  hue           Float     @default(0) @db.Real
  font          Font      @default(MODERN)
  coverImageKey String?   @map("cover_image_key")

  author             User           @relation("Pages", fields: [authorId], references: [id], onDelete: Cascade)
  profileUser        User?          @relation("ProfilePage")
  tiles              Tile[]
  referringPageLinks PageLinkTile[] @relation("LinkedPage")
  bookmarks          Bookmark[]
  images             ImageTile[]
  videos             VideoTile[]
  text               TextTile[]
  links              LinkTile[]
  maps               MapTile[]
  pageLinks          PageLinkTile[] @relation("Page")
  collections        Collection[]
  tables             Table[]
  access             PageAccess[]
  invites            PageInvite[]

  @@index([authorId])
  @@index([authorId, updatedAt])
  @@map("pages")
}

enum TileType {
  IMAGE
  VIDEO
  TEXT
  PLACE
  LINK
  PAGE_LINK
  COLLECTION
  MAP
  TABLE
}

model Tile {
  id                 String   @id @default(uuid()) @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  pageId             String   @map("page_id") @db.Uuid
  position           Int
  columns            Int      @default(1) @db.SmallInt
  rows               Int      @default(1) @db.SmallInt
  imageTileId        String?  @map("image_tile_id") @db.Uuid
  videoTileId        String?  @map("video_tile_id") @db.Uuid
  textTileId         String?  @map("text_tile_id") @db.Uuid
  mapTileId          String?  @map("map_tile_id") @db.Uuid
  linkTileId         String?  @map("link_tile_id") @db.Uuid
  pageLinkTileId     String?  @map("page_link_tile_id") @db.Uuid
  tableId            String?  @map("table_id") @db.Uuid
  collectionId       String?  @map("collection_id") @db.Uuid
  parentCollectionId String   @map("parent_collection_id") @db.Uuid

  page             Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentCollection Collection    @relation("ParentCollection", fields: [parentCollectionId], references: [id], onDelete: Cascade)
  type             TileType
  image            ImageTile?    @relation(fields: [imageTileId], references: [id], onDelete: SetNull)
  video            VideoTile?    @relation(fields: [videoTileId], references: [id], onDelete: SetNull)
  text             TextTile?     @relation(fields: [textTileId], references: [id], onDelete: SetNull)
  map              MapTile?      @relation(fields: [mapTileId], references: [id], onDelete: SetNull)
  link             LinkTile?     @relation(fields: [linkTileId], references: [id], onDelete: SetNull)
  pageLink         PageLinkTile? @relation(fields: [pageLinkTileId], references: [id], onDelete: SetNull)
  collection       Collection?   @relation("CollectionTile", fields: [collectionId], references: [id], onDelete: SetNull)
  table            Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@map("tiles")
}

model ImageTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  imageKey  String   @map("image_key")
  originX   Float    @default(0.5) @map("origin_x") @db.Real
  originY   Float    @default(0.5) @map("origin_y") @db.Real
  /// [RichText]
  text      Json?    @db.JsonB

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles Tile[]

  @@index([pageId])
  @@map("image_tiles")
}

enum VideoType {
  YOUTUBE
}

model VideoTile {
  id               String    @id @default(uuid()) @db.Uuid
  pageId           String    @map("page_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  videoType        VideoType @map("video_type")
  videoId          String    @map("video_id")
  originalImageUrl String?   @map("original_image_url")
  title            String
  description      String?

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles Tile[]

  @@index([pageId])
  @@map("video_tiles")
}

model TextTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// [RichText]
  content   Json    @db.JsonB
  lightness Float?  @db.Real
  chroma    Float?  @db.Real
  hue       Float?  @db.Real
  imageKey  String? @map("image_key")
  expand    Boolean @default(false)

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles Tile[]

  @@index([pageId])
  @@map("text_tiles")
}

model Place {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  name        String
  lat         Float
  long        Float
  boundingBox Float[]  @map("bounding_box")
  address     String?
  providerId  String?  @map("provider_id")
  mapTileId   String   @map("map_tile_id") @db.Uuid

  map MapTile @relation(fields: [mapTileId], references: [id], onDelete: Cascade)

  @@index([mapTileId])
  @@map("places")
}

model MapTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tiles  Tile[]
  places Place[]
  page   Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("map_tiles")
}

model LinkTile {
  id               String   @id @default(uuid()) @db.Uuid
  pageId           String   @map("page_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  url              String
  title            String?
  description      String?
  siteName         String?  @map("site_name")
  originalImageUrl String?  @map("original_image_url")

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles Tile[]

  @@index([pageId])
  @@map("link_tiles")
}

model PageLinkTile {
  id           String   @id @default(uuid()) @db.Uuid
  pageId       String   @map("page_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  linkedPageId String?  @map("linked_page_id") @db.Uuid

  page       Page   @relation("Page", fields: [pageId], references: [id], onDelete: Cascade)
  linkedPage Page?  @relation("LinkedPage", fields: [linkedPageId], references: [id], onDelete: SetNull)
  tiles      Tile[]

  @@index([pageId])
  @@map("page_link_tiles")
}

model Collection {
  id        String          @id @default(uuid()) @db.Uuid
  pageId    String          @map("page_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  title     String?
  type      CollectionType  @default(TILE)
  width     CollectionWidth @default(DEFAULT)

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles Tile[] @relation("CollectionTile")
  items Tile[] @relation("ParentCollection")

  @@index([pageId])
  @@map("collections")
}

model Table {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page         Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles        Tile[]
  tableColumns TableColumn[]
  tableRows    TableRow[]

  @@index([pageId])
  @@map("table_tiles")
}

model TableColumn {
  id      String @id @default(uuid()) @db.Uuid
  tableId String @map("table_id") @db.Uuid
  width   Int    @default(200)

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@map("table_columns")
}

model TableRow {
  id      String @id @default(uuid()) @db.Uuid
  tableId String @map("table_id") @db.Uuid
  /// [TableRowData]
  data    Json   @db.JsonB

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@map("table_rows")
}
