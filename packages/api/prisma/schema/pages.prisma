enum Font {
  MODERN
  CLASSIC
  CODE
  ROUNDED
  BUBBLES
}

enum VerticalAlignment {
  TOP
  CENTER
  BOTTOM
}

enum GradientDirection {
  VERTICAL
  HORIZONTAL
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

enum ChartType {
  BAR
  LINE
  PIE
}

model Page {
  id            String    @id @default(uuid()) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  workspaceId   String    @map("workspace_id") @db.Uuid
  authorId      String    @map("author_id") @db.Uuid
  folderId      String?   @map("folder_id") @db.Uuid
  published     Boolean   @default(false)
  title         String    @db.VarChar(100)
  lightness     Float     @default(1) @db.Real
  chroma        Float     @default(0) @db.Real
  hue           Float     @default(0) @db.Real
  font          Font      @default(MODERN)
  coverImageKey String?   @map("cover_image_key")

  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author             User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  folder             Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sections           Section[]
  tiles              Tile[]
  referringPageLinks PageLinkTile[] @relation("LinkedPage")
  bookmarks          Bookmark[]
  images             ImageTile[]
  videos             VideoTile[]
  text               TextTile[]
  links              LinkTile[]
  maps               MapTile[]
  pageLinks          PageLinkTile[] @relation("Page")
  tables             Table[]
  access             PageAccess[]
  invites            PageInvite[]
  dropdowns          Dropdown[]
  charts             Chart[]

  @@index([authorId])
  @@index([authorId, updatedAt])
  @@map("pages")
}

enum TileType {
  IMAGE
  VIDEO
  TEXT
  PLACE
  LINK
  PAGE_LINK
  MAP
  TABLE
  CHART
}

model Tile {
  id             String   @id @default(uuid()) @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  pageId         String   @map("page_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  position       Int
  width          Int      @default(1) @db.SmallInt
  height         Int      @default(1) @db.SmallInt
  rowSpan        Int      @default(1) @map("row_span") @db.SmallInt
  x              Int      @default(0) @db.SmallInt
  y              Int      @db.SmallInt
  block          Boolean  @default(true)
  imageTileId    String?  @map("image_tile_id") @db.Uuid
  videoTileId    String?  @map("video_tile_id") @db.Uuid
  textTileId     String?  @map("text_tile_id") @db.Uuid
  mapTileId      String?  @map("map_tile_id") @db.Uuid
  linkTileId     String?  @map("link_tile_id") @db.Uuid
  pageLinkTileId String?  @map("page_link_tile_id") @db.Uuid
  tableId        String?  @map("table_id") @db.Uuid
  chartId        String?  @map("chart_id") @db.Uuid
  type           TileType

  page     Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  section  Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  image    ImageTile?    @relation(fields: [imageTileId], references: [id], onDelete: SetNull)
  video    VideoTile?    @relation(fields: [videoTileId], references: [id], onDelete: SetNull)
  text     TextTile?     @relation(fields: [textTileId], references: [id], onDelete: SetNull)
  map      MapTile?      @relation(fields: [mapTileId], references: [id], onDelete: SetNull)
  link     LinkTile?     @relation(fields: [linkTileId], references: [id], onDelete: SetNull)
  pageLink PageLinkTile? @relation(fields: [pageLinkTileId], references: [id], onDelete: SetNull)
  table    Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  chart    Chart?        @relation(fields: [chartId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([sectionId, y])
  @@map("tiles")
}

model ImageTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  imageKey  String   @map("image_key")
  originX   Float    @default(0.5) @map("origin_x") @db.Real
  originY   Float    @default(0.5) @map("origin_y") @db.Real
  /// [RichText]
  text      Json?    @db.JsonB
  theme     String?

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles Tile[]

  @@index([pageId])
  @@map("image_tiles")
}

enum VideoType {
  YOUTUBE
}

model VideoTile {
  id               String    @id @default(uuid()) @db.Uuid
  pageId           String    @map("page_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  videoType        VideoType @map("video_type")
  videoId          String    @map("video_id")
  originalImageUrl String?   @map("original_image_url")
  title            String
  description      String?

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles Tile[]

  @@index([pageId])
  @@map("video_tiles")
}

model TextTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// [RichText]
  content            Json               @db.JsonB
  textL              Float?             @map("text_l") @db.Real
  textC              Float?             @map("text_c") @db.Real
  textH              Float?             @map("text_h") @db.Real
  backgroundL        Float?             @map("background_l") @db.Real
  backgroundC        Float?             @map("background_c") @db.Real
  backgroundH        Float?             @map("background_h") @db.Real
  backgroundBL       Float?             @map("background_b_l") @db.Real
  backgroundBC       Float?             @map("background_b_c") @db.Real
  backgroundBH       Float?             @map("background_b_h") @db.Real
  backgroundGradient GradientDirection? @map("background_gradient")
  backgroundImageKey String?            @map("background_image_key")
  align              VerticalAlignment  @default(TOP)

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles Tile[]

  @@index([pageId])
  @@map("text_tiles")
}

model Place {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  name        String
  lat         Float
  long        Float
  boundingBox Float[]  @map("bounding_box")
  address     String?
  providerId  String?  @map("provider_id")
  mapTileId   String   @map("map_tile_id") @db.Uuid

  map MapTile @relation(fields: [mapTileId], references: [id], onDelete: Cascade)

  @@index([mapTileId])
  @@map("places")
}

model MapTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tiles  Tile[]
  places Place[]
  page   Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("map_tiles")
}

model LinkTile {
  id               String   @id @default(uuid()) @db.Uuid
  pageId           String   @map("page_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  url              String
  title            String?
  description      String?
  siteName         String?  @map("site_name")
  originalImageUrl String?  @map("original_image_url")

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles Tile[]

  @@index([pageId])
  @@map("link_tiles")
}

model PageLinkTile {
  id           String   @id @default(uuid()) @db.Uuid
  pageId       String   @map("page_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  linkedPageId String?  @map("linked_page_id") @db.Uuid

  page       Page   @relation("Page", fields: [pageId], references: [id], onDelete: Cascade)
  linkedPage Page?  @relation("LinkedPage", fields: [linkedPageId], references: [id], onDelete: SetNull)
  tiles      Tile[]

  @@index([pageId])
  @@map("page_link_tiles")
}

model Table {
  id                 String             @id @default(uuid()) @db.Uuid
  pageId             String             @map("page_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  textL              Float?             @map("text_l") @db.Real
  textC              Float?             @map("text_c") @db.Real
  textH              Float?             @map("text_h") @db.Real
  backgroundL        Float?             @map("background_l") @db.Real
  backgroundC        Float?             @map("background_c") @db.Real
  backgroundH        Float?             @map("background_h") @db.Real
  backgroundBL       Float?             @map("background_b_l") @db.Real
  backgroundBC       Float?             @map("background_b_c") @db.Real
  backgroundBH       Float?             @map("background_b_h") @db.Real
  backgroundGradient GradientDirection? @map("background_gradient")
  backgroundImageKey String?            @map("background_image_key")

  page    Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles   Tile[]
  columns TableColumn[]
  rows    TableRow[]

  @@index([pageId])
  @@map("table_tiles")
}

model TableColumn {
  id      String @id @default(uuid()) @db.Uuid
  tableId String @map("table_id") @db.Uuid
  order   String
  width   Int    @default(200) @db.SmallInt

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, order])
  @@index([tableId, order])
  @@map("table_columns")
}

model TableRow {
  id      String @id @default(uuid()) @db.Uuid
  tableId String @map("table_id") @db.Uuid
  order   String
  height  Int    @default(32) @db.SmallInt
  /// [TableRowData]
  data    Json   @db.JsonB

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, order])
  @@index([tableId, order])
  @@map("table_rows")
}

model Dropdown {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pageId    String   @map("page_id") @db.Uuid
  /// [DropdownOptions]
  options   Json     @db.JsonB

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("dropdowns")
}

model Chart {
  id                 String             @id @default(uuid()) @db.Uuid
  pageId             String             @map("page_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  chartType          ChartType
  backgroundL        Float?             @map("background_l") @db.Real
  backgroundC        Float?             @map("background_c") @db.Real
  backgroundH        Float?             @map("background_h") @db.Real
  backgroundBL       Float?             @map("background_b_l") @db.Real
  backgroundBC       Float?             @map("background_b_c") @db.Real
  backgroundBH       Float?             @map("background_b_h") @db.Real
  backgroundGradient GradientDirection? @map("background_gradient")
  backgroundImageKey String?            @map("background_image_key")

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tiles Tile[]

  @@index([pageId])
  @@map("charts")
}
