enum GradientDirection {
  VERTICAL
  HORIZONTAL
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

enum PageType {
  DOCUMENT
  PRESENTATION
  COLLECTION
  FREE
}

model Page {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  workspaceId String    @map("workspace_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  folderId    String?   @map("folder_id") @db.Uuid
  published   Boolean   @default(false)
  title       String    @db.VarChar(100)
  type        PageType  @default(FREE)

  documentId String @unique @map("document_id") @db.Uuid

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  folder    Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  bookmarks Bookmark[]
  access    PageAccess[]
  invites   PageInvite[]
  document  PageDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([authorId, updatedAt])
  @@index([workspaceId])
  @@index([folderId])
  @@index([deletedAt])
  @@map("pages")
}

model PageDocument {
  id            String   @id @default(uuid()) @db.Uuid
  snapshot      Bytes    @db.ByteA
  schemaVersion Int      @default(1) @map("schema_version")
  updatedAt     DateTime @updatedAt @map("updated_at")

  page Page?

  @@map("page_documents")
}
