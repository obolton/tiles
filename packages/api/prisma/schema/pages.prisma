enum Font {
  MODERN
  CLASSIC
  CODE
  ROUNDED
  BUBBLES
}

enum Anchor {
  TOP
  LEFT
  RIGHT
  BOTTOM
}

enum Dimensions {
  LANDSCAPE
  PORTRAIT
  CUSTOM
}

enum VerticalAlignment {
  TOP
  CENTER
  BOTTOM
}

enum GradientDirection {
  VERTICAL
  HORIZONTAL
  BOTTOM_RIGHT
  BOTTOM_LEFT
}

enum ChartSeriesType {
  BAR
  LINE
  AREA
}

enum VideoType {
  YOUTUBE
}

enum TileType {
  SECTION
  TEXT
  IMAGE
  VIDEO
  LINK
  PAGE_LINK
  MAP
  TABLE
  CHART
}

enum Animation {
  FADE
  SLIDE
  GROW
  SHRINK
}

model Page {
  id              String    @id @default(uuid()) @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  workspaceId     String    @map("workspace_id") @db.Uuid
  authorId        String    @map("author_id") @db.Uuid
  folderId        String?   @map("folder_id") @db.Uuid
  published       Boolean   @default(false)
  title           String    @db.VarChar(100)
  backgroundColor Bytes?    @map("background_color") @db.ByteA
  font            Font      @default(MODERN)
  coverImageKey   String?   @map("cover_image_key")

  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author             User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  folder             Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sections           Section[]
  tiles              Tile[]
  referringPageLinks PageLinkTile[] @relation("LinkedPage")
  bookmarks          Bookmark[]
  images             ImageTile[]
  videos             VideoTile[]
  text               TextTile[]
  links              LinkTile[]
  maps               MapTile[]
  pageLinks          PageLinkTile[] @relation("Page")
  tables             Table[]
  access             PageAccess[]
  invites            PageInvite[]
  dropdowns          Dropdown[]
  charts             Chart[]

  @@index([authorId])
  @@index([authorId, updatedAt])
  @@map("pages")
}

model Tile {
  id         String     @id @default(uuid()) @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at")
  pageId     String     @map("page_id") @db.Uuid
  sectionId  String?    @map("section_id") @db.Uuid
  type       TileType
  order      String
  anchor     Anchor?
  dimensions Dimensions @default(CUSTOM)
  width      Int        @default(1) @db.SmallInt
  height     Int        @default(1) @db.SmallInt
  rowSpan    Int        @default(1) @map("row_span") @db.SmallInt
  x          Int        @default(0) @db.SmallInt
  y          Int        @db.SmallInt
  block      Boolean    @default(true)
  animation  Animation?
  hide       Boolean    @default(false)

  page          Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentSection Section?      @relation("ParentSection", fields: [sectionId], references: [id], onDelete: Cascade)
  section       Section?      @relation("Tile")
  text          TextTile?
  image         ImageTile?
  video         VideoTile?
  link          LinkTile?
  pageLink      PageLinkTile?
  map           MapTile?
  table         Table?
  chart         Chart?

  @@index([pageId])
  @@index([sectionId])
  @@index([order])
  @@index([hide])
  @@map("tiles")
}

model TextTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  /// [RichText]
  content            Json               @db.JsonB
  textColor          Bytes?             @map("text_color") @db.ByteA
  backgroundColor    Bytes?             @map("background_color") @db.ByteA
  backgroundGradient GradientDirection? @map("background_gradient")
  backgroundImageId  String?            @map("background_image_id") @db.Uuid
  align              VerticalAlignment  @default(TOP)

  page            Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tile            Tile   @relation(fields: [id], references: [id], onDelete: Cascade)
  backgroundImage Image? @relation(fields: [backgroundImageId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@map("text_tiles")
}

model ImageTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  imageId String? @map("image_id") @db.Uuid
  originX Float   @default(0.5) @map("origin_x") @db.Real
  originY Float   @default(0.5) @map("origin_y") @db.Real
  /// [RichText]
  text    Json?   @db.JsonB
  theme   String?

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tile  Tile   @relation(fields: [id], references: [id], onDelete: Cascade)
  image Image? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@map("image_tiles")
}

model VideoTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  videoType        VideoType @map("video_type")
  videoId          String    @map("video_id")
  originalImageUrl String?   @map("original_image_url")
  title            String
  description      String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tile Tile @relation(fields: [id], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("video_tiles")
}

model Place {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  name        String
  lat         Float
  long        Float
  boundingBox Float[]  @map("bounding_box")
  address     String?
  providerId  String?  @map("provider_id")
  mapTileId   String   @map("map_tile_id") @db.Uuid

  map MapTile @relation(fields: [mapTileId], references: [id], onDelete: Cascade)

  @@index([mapTileId])
  @@map("places")
}

model MapTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  page   Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tile   Tile    @relation(fields: [id], references: [id], onDelete: Cascade)
  places Place[]

  @@index([pageId])
  @@map("map_tiles")
}

model LinkTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  url              String
  title            String?
  description      String?
  siteName         String? @map("site_name")
  originalImageUrl String? @map("original_image_url")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tile Tile @relation(fields: [id], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("link_tiles")
}

model PageLinkTile {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  linkedPageId String? @map("linked_page_id") @db.Uuid

  page       Page  @relation("Page", fields: [pageId], references: [id], onDelete: Cascade)
  tile       Tile  @relation(fields: [id], references: [id], onDelete: Cascade)
  linkedPage Page? @relation("LinkedPage", fields: [linkedPageId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@map("page_link_tiles")
}

model Table {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  textColor          Bytes?             @map("text_color") @db.ByteA
  backgroundColor    Bytes?             @map("background_color") @db.ByteA
  backgroundGradient GradientDirection? @map("background_gradient")
  backgroundImageId  String?            @map("background_image_id") @db.Uuid

  page            Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tile            Tile          @relation(fields: [id], references: [id], onDelete: Cascade)
  backgroundImage Image?        @relation(fields: [backgroundImageId], references: [id], onDelete: SetNull)
  columns         TableColumn[]
  rows            TableRow[]
  charts          Chart[]

  @@index([pageId])
  @@map("table_tiles")
}

model TableColumn {
  id      String  @id @default(uuid()) @db.Uuid
  tableId String  @map("table_id") @db.Uuid
  order   String
  title   String?
  width   Int     @default(200) @db.SmallInt

  backgroundColor    Bytes?             @map("background_color") @db.ByteA
  backgroundGradient GradientDirection? @map("background_gradient")
  backgroundImageId  String?            @map("background_image_id") @db.Uuid

  table           Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  backgroundImage Image?        @relation(fields: [backgroundImageId], references: [id], onDelete: SetNull)
  chartSeries     ChartSeries[]
  labelsCharts    Chart[]

  @@unique([tableId, order])
  @@index([tableId, order])
  @@map("table_columns")
}

model TableRow {
  id      String @id @default(uuid()) @db.Uuid
  tableId String @map("table_id") @db.Uuid
  order   String
  height  Int    @default(32) @db.SmallInt
  /// [TableRowData]
  data    Json   @db.JsonB

  backgroundColor    Bytes?             @map("background_color") @db.ByteA
  backgroundGradient GradientDirection? @map("background_gradient")
  backgroundImageId  String?            @map("background_image_id") @db.Uuid

  table           Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  backgroundImage Image? @relation(fields: [backgroundImageId], references: [id], onDelete: SetNull)

  @@unique([tableId, order])
  @@index([tableId, order])
  @@map("table_rows")
}

model Dropdown {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  pageId    String   @map("page_id") @db.Uuid
  title     String?  @db.VarChar(100)
  /// [DropdownOptions]
  options   Json     @db.JsonB

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("dropdowns")
}

model Chart {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tableId            String             @map("table_id") @db.Uuid
  labelColumnId      String?            @map("label_column_id") @db.Uuid
  textColor          Bytes?             @map("text_color") @db.ByteA
  backgroundColor    Bytes?             @map("background_color") @db.ByteA
  backgroundGradient GradientDirection? @map("background_gradient")
  backgroundImageId  String?            @map("background_image_id") @db.Uuid

  page            Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tile            Tile          @relation(fields: [id], references: [id], onDelete: Cascade)
  backgroundImage Image?        @relation(fields: [backgroundImageId], references: [id], onDelete: SetNull)
  table           Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  label           TableColumn?  @relation(fields: [labelColumnId], references: [id], onDelete: SetNull)
  series          ChartSeries[]

  @@index([pageId])
  @@map("charts")
}

model ChartSeries {
  id        String          @id @default(uuid()) @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")
  chartId   String          @map("chart_id") @db.Uuid
  columnId  String          @map("column_id") @db.Uuid
  type      ChartSeriesType @default(BAR)
  color     Bytes?          @db.ByteA

  chart  Chart       @relation(fields: [chartId], references: [id], onDelete: Cascade)
  column TableColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([chartId, columnId])
  @@index([chartId])
  @@map("chart_series")
}
