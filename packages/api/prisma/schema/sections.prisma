enum Layout {
  GRID
  HORIZONTAL
  VERTICAL
  FREEFORM
}

enum Anchor {
  TOP
  LEFT
  RIGHT
  BOTTOM
}

enum Dimensions {
  LANDSCAPE
  PORTRAIT
  CUSTOM
}

model Section {
  id                 String             @id @default(uuid()) @db.Uuid
  pageId             String             @map("page_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  layout             Layout             @default(GRID)
  anchor             Anchor?
  order              String
  dimensions         Dimensions         @default(CUSTOM)
  width              Int                @default(20) @db.SmallInt
  height             Int                @default(20) @db.SmallInt
  backgroundL        Float?             @map("background_l") @db.Real
  backgroundC        Float?             @map("background_c") @db.Real
  backgroundH        Float?             @map("background_h") @db.Real
  backgroundBL       Float?             @map("background_b_l") @db.Real
  backgroundBC       Float?             @map("background_b_c") @db.Real
  backgroundBH       Float?             @map("background_b_h") @db.Real
  backgroundGradient GradientDirection? @map("background_gradient")
  backgroundImageId  String?            @map("background_image_id") @db.Uuid
  hide               Boolean            @default(false)

  page            Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  items           Tile[]
  backgroundImage Image? @relation(fields: [backgroundImageId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([order])
  @@index([hide])
  @@map("sections")
}
