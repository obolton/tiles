model Theme {
  id          String   @id @default(uuid()) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(50)

  // Colors
  backgroundColor    Bytes              @map("background_color") @db.ByteA
  backgroundGradient GradientDirection? @map("background_gradient")
  textColor          Bytes              @map("text_color") @db.ByteA
  accentColor        Bytes              @map("accent_color") @db.ByteA

  // Fonts
  headingFont String @default("inter") @map("heading_font")
  bodyFont    String @default("inter") @map("body_font")
  codeFont    String @default("jetbrains-mono") @map("code_font")

  // Borders
  borderColor Bytes? @map("border_color") @db.ByteA

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages     Page[]

  @@index([workspaceId])
  @@map("themes")
}
