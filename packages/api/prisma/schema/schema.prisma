generator client {
  provider        = "prisma-client"
  engineType      = "client"
  output          = "../../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres", "typedSql"]
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
