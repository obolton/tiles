{
  "name": "dev-cdn",
  "version": "0.0.1",
  "private": true,
  "description": "Dev-only CDN worker",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/state",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "typecheck": "tsc --build",
    "generate": "wrangler types src/worker.d.ts"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}
