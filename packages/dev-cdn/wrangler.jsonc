{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dev-cdn",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  "send_metrics": false,
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "tiles-dev-images",
    },
  ],
  "dev": {
    "ip": "0.0.0.0",
    "port": 3003,
    "inspector_port": 9230,
    "local_protocol": "http",
  },
}
