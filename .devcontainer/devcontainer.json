{
  "name": "Tiles (${localWorkspaceFolderBasename})",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/projects/${localWorkspaceFolderBasename}",

  "initializeCommand": ".devcontainer/init.sh ${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    }
  },

  "portsAttributes": {
    "3000": {
      "label": "Web",
      "onAutoForward": "ignore"
    },
    "3001": {
      "label": "API",
      "onAutoForward": "ignore"
    },
    "3002": {
      "label": "Uploads",
      "onAutoForward": "ignore"
    },
    "6001": {
      "label": "Storybook",
      "onAutoForward": "ignore"
    }
  },

  "postCreateCommand": "pnpm install && pnpm --filter api db:push && pnpm --filter api db:push-functions && pnpm generate && pnpm --filter api db:seed",

  "containerEnv": {
    "CHECKPOINT_DISABLE": "1",
    "WRANGLER_LOG": "info",
    "CLOUDFLARE_INCLUDE_PROCESS_ENV": "true"
  },

  "remoteEnv": {
    "DATABASE_URL": "postgresql://tiles@tiles-db:5432/${containerEnv:DATABASE_NAME}",
    "API_HOST": "0.0.0.0",
    "API_PORT": "3001",
    "WEB_HOST": "0.0.0.0",
    "WEB_PORT": "3000",
    "INTERNAL_API_ORIGIN": "http://localhost:3001",
    "GOOGLE_REDIRECT_URI": "https://localhost/sign-in/google/callback",
    "PUBLIC_API_ORIGIN": "https://api.${localWorkspaceFolderBasename}.tiles.test",
    "PUBLIC_COLLABORATION_URL": "wss://api.${localWorkspaceFolderBasename}.tiles.test/collaboration",
    "PUBLIC_WEB_ORIGIN": "https://${localWorkspaceFolderBasename}.tiles.test",
    "PUBLIC_UPLOAD_ORIGIN": "https://uploads.${localWorkspaceFolderBasename}.tiles.test",
    "PUBLIC_SESSION_COOKIE_DOMAIN": ".${localWorkspaceFolderBasename}.tiles.test",
    "PLAYWRIGHT_HOST": "tiles-playwright",
    "APP_HOST": "${localWorkspaceFolderBasename}-app"
  },

  "remoteUser": "node",

  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-containers",
        "oxc.oxc-vscode",
        "Prisma.prisma",
        "stylelint.vscode-stylelint",
        "vitest.explorer"
      ]
    }
  }
}
