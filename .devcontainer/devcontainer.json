{
  "name": "Tiles",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/projects/${localWorkspaceFolderBasename}",

  "initializeCommand": ".devcontainer/init.sh ${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    }
  },

  "forwardPorts": [3000, 3001, 5432, 6001],
  "portsAttributes": {
    "3000": {
      "label": "Web Frontend",
      "onAutoForward": "notify"
    },
    "3001": {
      "label": "API Server",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    },
    "6001": {
      "label": "Storybook",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "pnpm install && pnpm --filter api db:push && pnpm --filter api db:push-functions && pnpm --filter api db:generate-client-sql && pnpm --filter api db:seed",

  "containerEnv": {
    "CHECKPOINT_DISABLE": "1", // Disable Prisma telemetry
    "WRANGLER_LOG": "info"
  },

  "remoteEnv": {
    "DATABASE_URL": "postgresql://tiles:tiles@db:5432/tiles",
    "ENABLE_HTTPS": "true",
    "CERTIFICATE_PATH": "/projects/localhost.pem",
    "CERTIFICATE_KEY_PATH": "/projects/localhost-key.pem"
  },

  "remoteUser": "node",

  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-containers",
        "ms-vscode-remote.remote-containers",
        "oxc.oxc-vscode",
        "Prisma.prisma",
        "stylelint.vscode-stylelint",
        "vitest.explorer"
      ]
    }
  }
}
