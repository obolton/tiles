{
  "name": "Tiles (${localWorkspaceFolderBasename})",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/projects/${localWorkspaceFolderBasename}",

  "initializeCommand": ".devcontainer/init.sh ${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    }
  },

  "portsAttributes": {
    "3000": {
      "label": "Web",
      "onAutoForward": "ignore"
    },
    "3001": {
      "label": "API",
      "onAutoForward": "ignore"
    },
    "3002": {
      "label": "Uploads",
      "onAutoForward": "ignore"
    },
    "6001": {
      "label": "Storybook",
      "onAutoForward": "ignore"
    }
  },

  "postCreateCommand": "pnpm install && pnpm --filter api db:push && pnpm --filter api db:push-functions && pnpm --filter api db:generate-client-sql && pnpm --filter api db:seed",

  "containerEnv": {
    "CHECKPOINT_DISABLE": "1",
    "WRANGLER_LOG": "info"
  },

  "remoteEnv": {
    "DATABASE_URL": "postgresql://tiles:tiles@tiles-db:5432/tiles",
    "HOST": "0.0.0.0",
    "PORT": "3001",
    "DEV_SERVER_PORT": "3000",
    "CLIENT_ORIGIN": "https://${localWorkspaceFolderBasename}.tiles.test",
    "API_URL": "http://localhost:3001",
    "PUBLIC_API_BASE_URL": "https://api.${localWorkspaceFolderBasename}.tiles.test",
    "PUBLIC_WEB_BASE_URL": "https://${localWorkspaceFolderBasename}.tiles.test",
    "PUBLIC_UPLOAD_BASE_URL": "https://uploads.${localWorkspaceFolderBasename}.tiles.test",
    "GOOGLE_REDIRECT_URI": "https://localhost/sign-in/google/callback",
    "PUBLIC_SESSION_COOKIE_DOMAIN": ".tiles.test",
    "PUBLIC_OAUTH_ORIGIN": "https://tiles.tiles.test"
  },

  "remoteUser": "node",

  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-containers",
        "ms-vscode-remote.remote-containers",
        "oxc.oxc-vscode",
        "Prisma.prisma",
        "stylelint.vscode-stylelint",
        "vitest.explorer"
      ]
    }
  }
}
