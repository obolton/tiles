{
  "name": "tiles",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/api",
    "packages/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=api & npm run dev --workspace=web",
    "db:push": "npm run db:push --workspace=api",
    "db:seed": "npm run db:seed --workspace=api",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint && npm run lint:css --workspace=web",
    "storybook": "npm run storybook --workspace=web",
    "cdn:purge": "npm run cdn:purge --workspace=api",
    "tsc": "tsc --build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "oxlint": "^1.12.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
