{
  "name": "tiles",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter api dev & pnpm --filter web dev & pnpm --filter image-upload-worker dev",
    "db:push": "pnpm --filter api db:push",
    "db:seed": "pnpm --filter api db:seed",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint && pnpm --filter web lint:css",
    "storybook": "pnpm --filter web storybook",
    "cdn:purge": "pnpm --filter api cdn:purge",
    "tsc": "tsc --build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.3",
    "dotenv": "^17.2.2",
    "oxlint": "^1.29.0",
    "prettier": "^3.7.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  }
}
