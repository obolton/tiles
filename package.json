{
  "name": "tiles",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "db:create": ".devcontainer/bin/db-create",
    "db:use": ".devcontainer/bin/db-use",
    "db:current": ".devcontainer/bin/db-current",
    "db:list": ".devcontainer/bin/db-list",
    "db:drop": ".devcontainer/bin/db-drop",
    "db:push": "pnpm --filter api db:push",
    "db:seed": "pnpm --filter api db:seed",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm -r --parallel lint",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "storybook": "pnpm --filter web storybook",
    "cdn:purge": "pnpm --filter api cdn:purge",
    "typecheck": "tsc --build",
    "build": "pnpm -r --if-present build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "pnpm -r --parallel generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.9",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.70.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.30.3"
}
