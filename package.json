{
  "name": "tiles",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/api",
    "packages/image-upload-worker",
    "packages/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=api & npm run dev --workspace=web & npm run dev --workspace=image-upload-worker",
    "db:push": "npm run db:push --workspace=api",
    "db:seed": "npm run db:seed --workspace=api",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint && npm run lint:css --workspace=web",
    "storybook": "npm run storybook --workspace=web",
    "cdn:purge": "npm run cdn:purge --workspace=api",
    "tsc": "tsc --build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.3",
    "dotenv": "^17.2.2",
    "oxlint": "^1.29.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^4.0.3"
  }
}
