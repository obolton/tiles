{
  "name": "tiles",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "db:create": ".devcontainer/bin/db-create",
    "db:use": ".devcontainer/bin/db-use",
    "db:current": ".devcontainer/bin/db-current",
    "db:list": ".devcontainer/bin/db-list",
    "db:drop": ".devcontainer/bin/db-drop",
    "db:push": "pnpm --filter api db:push",
    "db:seed": "pnpm --filter api db:seed",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:compact": "vitest run --reporter=minimal",
    "lint": "oxlint && pnpm --filter web lint:css",
    "lint:compact": "oxlint --format=agent && pnpm --filter web lint:css",
    "check": "node scripts/check.ts",
    "storybook": "pnpm --filter web storybook",
    "cdn:purge": "pnpm --filter api cdn:purge",
    "typecheck": "tsc --build",
    "build": "pnpm -r --if-present build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "pnpm -r --parallel generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.9",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.71.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.10.0"
}
