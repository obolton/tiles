{
  "name": "tiles",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:start": "node scripts/dev/start.ts",
    "dev:stop": "node scripts/dev/stop.ts",
    "dev:logs": "tail -n 100 /tmp/tiles-dev.log",
    "db:create": ".devcontainer/bin/db-create",
    "db:use": ".devcontainer/bin/db-use",
    "db:current": ".devcontainer/bin/db-current",
    "db:list": ".devcontainer/bin/db-list",
    "db:drop": ".devcontainer/bin/db-drop",
    "db:push": "pnpm --filter api db:push",
    "db:seed": "pnpm --filter api db:seed",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware && pnpm --filter web lint:css",
    "lint:compact": "oxlint --type-aware --format=agent && pnpm --filter web lint:css",
    "check": "node scripts/check.ts",
    "storybook": "pnpm --filter web storybook",
    "cdn:purge": "pnpm --filter api cdn:purge",
    "fonts:sync": "pnpm --filter fonts sync",
    "typecheck": "tsc --build",
    "build": "pnpm -r --if-present build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "pnpm -r --parallel generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.11.2"
}
