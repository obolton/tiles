{
  "name": "tiles",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "db:create": ".devcontainer/bin/db-create",
    "db:use": ".devcontainer/bin/db-use",
    "db:current": ".devcontainer/bin/db-current",
    "db:list": ".devcontainer/bin/db-list",
    "db:drop": ".devcontainer/bin/db-drop",
    "db:push": "pnpm --filter api db:push",
    "db:seed": "pnpm --filter api db:seed",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm -r --parallel lint",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "storybook": "pnpm --filter web storybook",
    "cdn:purge": "pnpm --filter api cdn:purge",
    "typecheck": "tsc --build",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm -r --parallel generate"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
