{
  "mcpServers": {
    "chrome-devtools": {
      "command": "chrome-devtools-mcp",
      "args": [
        "--executable-path=/usr/bin/chromium",
        "--headless",
        "--isolated",
        "--chrome-arg=--no-sandbox",
        "--no-usage-statistics"
      ]
    },
    "chrome-devtools-host": {
      "command": "chrome-devtools-mcp",
      "args": ["--browser-url=http://127.0.0.1:9222", "--no-usage-statistics"]
    }
  }
}
