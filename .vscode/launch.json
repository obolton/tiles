{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Run",
      "command": "pnpm dev",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Development server: (https://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Debug",
      "command": "pnpm dev",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "startDebugging",
        "pattern": "Development server: (https://.+)",
        "name": "Chrome (Debug)",
        "killOnServerStop": true
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Chrome (Debug)",
      "url": "https://${workspaceFolderBasename}.tiles.test",
      "runtimeArgs": ["--remote-debugging-port=${env:CHROME_PORT}"],
      "webRoot": "${workspaceFolder}/packages/web/src"
    }
  ]
}
