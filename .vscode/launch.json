{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Run",
      "command": "npm run dev",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Development server: (https://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Debug",
      "command": "npm run dev",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "pattern": "Development server: (https://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}/packages/web/src",
        "killOnServerStop": true
      }
    }
  ]
}
