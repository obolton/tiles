{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true
  },
  "rules": {
    "curly": "error",
    "import/no-unassigned-import": "off",
    "no-shadow": "off"
  }
}
